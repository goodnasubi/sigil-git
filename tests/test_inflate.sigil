module tests.test_inflate
  targets server
  trust none

use git.error.error_kind_name;
use git.hash.hex_to_bytes;
use git.inflate.inflate_zlib;

fn bytes_of(hex: &String) -> Bytes
  intent "テスト用の 16 進文字列をバイト列にする"
  requires none
  ensures none
  effects none
{
  return hex_to_bytes(&hex).unwrap_or(Bytes.new());
}

fn roundtrip(z_hex: &String, want_hex: &String, trailing: Int) -> Bool
  intent "zlib の 16 進を伸長して期待どおりか、使った長さが入力の長さと一致するかを返す。trailing byte を後ろに付けても読まないことも確かめる"
  requires none
  ensures none
  effects none
{
  let z = bytes_of(&z_hex);
  let want = bytes_of(&want_hex);
  let mut padded = Bytes.new();
  padded.extend(&z);
  let mut i = 0;
  while i < trailing {
    padded.push(170);
    i = i + 1;
  }
  return match inflate_zlib(&padded, 0, 1000000) {
    Ok(r) => r.data == want && r.consumed == z.byte_len(),
    Err(_) => false,
  };
}

fn err_kind(z: &Bytes, start: Int, limit: Int) -> String
  intent "伸長の結果が失敗ならエラー種別、成功なら ok を返す"
  requires none
  ensures none
  effects none
{
  return match inflate_zlib(&z, start, limit) {
    Ok(_) => "ok",
    Err(e) => error_kind_name(&e),
  };
}

pub fn run_inflate_tests() -> Bool
  intent "git.inflate の全テストを実行し全合格なら true を返す。期待値は Python の zlib で作った"
  requires none
  ensures none
  effects none
{
  if !roundtrip(&"78da030000000001", &"", 0) || !roundtrip(&"78da030000000001", &"", 5) {
    return false;
  }
  if !roundtrip(&"78dacb48cdc9c957c84027b90070be08bb", &"68656c6c6f2068656c6c6f2068656c6c6f2068656c6c6f0a", 0) || !roundtrip(&"78dacb48cdc9c957c84027b90070be08bb", &"68656c6c6f2068656c6c6f2068656c6c6f2068656c6c6f0a", 5) {
    return false;
  }
  if !roundtrip(&"78014b4c4a4e8421001de00499", &"616263616263616263616263", 0) || !roundtrip(&"78014b4c4a4e8421001de00499", &"616263616263616263616263", 5) {
    return false;
  }
  if !roundtrip(&"", &"", 0) || !roundtrip(&"", &"", 5) {
    return false;
  }
  if !roundtrip(&"", &"", 0) || !roundtrip(&"", &"", 5) {
    return false;
  }
  let dyn_z = bytes_of(&"");
  let mut bad = Bytes.new();
  let mut i = 0;
  while i < dyn_z.byte_len() {
    let b = dyn_z.get(i).unwrap_or(0);
    if i == dyn_z.byte_len() - 1 {
      bad.push((b + 1) % 256);
    } else {
      bad.push(b);
    }
    i = i + 1;
  }
  if err_kind(&bad, 0, 1000000) != "Corrupt" {
    return false;
  }
  let cut = dyn_z.slice(0, 40).unwrap_or(Bytes.new());
  if err_kind(&cut, 0, 1000000) != "Corrupt" {
    return false;
  }
  if err_kind(&dyn_z, 0, 100) != "LimitExceeded" {
    return false;
  }
  if err_kind(&"hello".as_bytes(), 0, 100) != "Corrupt" {
    return false;
  }
  let mut reserved = Bytes.new();
  reserved.push(120);
  reserved.push(156);
  reserved.push(7);
  reserved.push(0);
  if err_kind(&reserved, 0, 100) != "Corrupt" {
    return false;
  }
  return true;
}
