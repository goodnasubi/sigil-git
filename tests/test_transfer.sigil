module tests.test_transfer
  targets server
  trust none

use git.error.GitError;
use git.error.error_kind_name;
use git.fsio.cat3;
use git.hash.int_to_str;
use git.limits.max_advertised_refs;
use git.limits.max_pkt_line_len;
use git.limits.max_transfer_response_size;
use git.pktline.pkt_decode_section;
use git.pktline.pkt_encode;
use git.pktline.pkt_encode_str;
use git.pktline.pkt_flush;
use git.transfer.AdvRef;
use git.transfer.advertise_receive_pack;
use git.transfer.advertise_upload_pack;
use git.transfer.check_requested_capabilities;
use git.transfer.check_transfer_feature;
use git.transfer.new_adv_ref;
use git.transfer.receive_pack_capabilities;
use git.transfer.transfer_supported_features;
use git.transfer.transfer_unsupported_features;
use git.transfer.upload_pack_capabilities;

// ADR 0048 第 1 段: pkt-line の符号化・復号、能力広告、対応表、固定上限の境界を試す。
// 実 Git との突き合わせは interop_transfer.sh。

fn fail(label: &String) -> Bool
  intent "失敗したラベルを出力して false を返す"
  requires none
  ensures none
  effects console
{
  console.log(&cat3(&"  FAILED: ", &label, &""));
  return false;
}

fn expect(cond: Bool, label: &String) -> Bool
  intent "cond が偽ならラベルを出力して false を返す"
  requires none
  ensures none
  effects console
{
  if !cond {
    return fail(&label);
  }
  return true;
}

fn rep(ch: &String, n: Int) -> String
  intent "文字 ch（1 byte）を n 回並べた文字列を返す"
  requires n >= 0
  ensures none
  effects none
{
  let one = ch.as_bytes().get(0).unwrap_or(97);
  let mut b = Bytes.new();
  let mut i = 0;
  while i < n {
    b.push(one);
    i = i + 1;
  }
  return b.to_string_utf8().unwrap_or("");
}

fn pad4(n: Int) -> String
  intent "n を 4 桁の 0 埋めの 10 進文字列にする"
  requires n >= 0 && n < 10000
  ensures none
  effects none
{
  let s = int_to_str(n);
  return cat3(&rep(&"0", 4 - s.len()), &s, &"");
}

fn kind_of_bytes(r: Result<Bytes, GitError>) -> String
  intent "結果がエラーならその種別名、成功なら ok を返す"
  requires none
  ensures none
  effects none
{
  return match r {
    Ok(_) => "ok",
    Err(e) => error_kind_name(&e),
  };
}

fn kind_of_lines(r: Result<List<Bytes>, GitError>) -> String
  intent "結果がエラーならその種別名、成功なら ok を返す"
  requires none
  ensures none
  effects none
{
  return match r {
    Ok(_) => "ok",
    Err(e) => error_kind_name(&e),
  };
}

fn kind_of_bool(r: Result<Bool, GitError>) -> String
  intent "結果がエラーならその種別名、成功なら ok を返す"
  requires none
  ensures none
  effects none
{
  return match r {
    Ok(_) => "ok",
    Err(e) => error_kind_name(&e),
  };
}

fn text_of(b: &Bytes) -> String
  intent "バイト列を文字列にする（不正な UTF-8 は空）"
  requires none
  ensures none
  effects none
{
  return b.to_string_utf8().unwrap_or("");
}

fn item_text(l: &List<Bytes>, i: Int) -> String
  intent "バイト列のリストの i 番目を文字列にして返す（範囲外は空）"
  requires none
  ensures none
  effects none
{
  return match l.get(i) {
    Some(v) => text_of(&v),
    None => "",
  };
}

fn lines_of(r: Result<Bytes, GitError>) -> List<String>
  intent "広告の結果を pkt-line の区間として復号し、各行の文字列を返す。失敗なら空のリスト"
  requires none
  ensures none
  effects none
{
  let mut out = List.new();
  match r {
    Err(_) => {}
    Ok(b) => {
      match pkt_decode_section(&b) {
        Err(_) => {}
        Ok(ls) => {
          let mut i = 0;
          while i < ls.len() {
            match ls.get(i) {
              None => {}
              Some(l) => {
                out.push(text_of(&l));
              }
            }
            i = i + 1;
          }
        }
      }
    }
  }
  return out;
}

fn line_at(l: &List<String>, i: Int) -> String
  intent "文字列のリストの i 番目の複製を返す（範囲外は空）"
  requires none
  ensures none
  effects none
{
  return match l.get(i) {
    Some(v) => v.clone(),
    None => "",
  };
}

fn contains(hay: &String, needle: &String) -> Bool
  intent "hay に needle が部分列として含まれるかを返す"
  requires none
  ensures none
  effects none
{
  let h = hay.as_bytes();
  let n = needle.as_bytes();
  if n.len() == 0 {
    return true;
  }
  let mut i = 0;
  while i + n.len() <= h.len() {
    let mut j = 0;
    let mut same = true;
    while j < n.len() && same {
      if h.get(i + j).unwrap_or(0) != n.get(j).unwrap_or(1) {
        same = false;
      }
      j = j + 1;
    }
    if same {
      return true;
    }
    i = i + 1;
  }
  return false;
}

fn words(s: &String) -> List<String>
  intent "空白で区切った語の列を返す"
  requires none
  ensures none
  effects none
{
  let b = s.as_bytes();
  let mut out = List.new();
  let mut cur = Bytes.new();
  let mut i = 0;
  while i <= b.len() {
    let c = b.get(i).unwrap_or(32);
    if c == 32 {
      if cur.len() > 0 {
        out.push(cur.to_string_utf8().unwrap_or(""));
        cur = Bytes.new();
      }
    } else {
      cur.push(c);
    }
    i = i + 1;
  }
  return out;
}

fn dec_kind(s: &String) -> String
  intent "文字列を pkt-line の区間として復号した結果の種別名（成功なら ok）を返す"
  requires none
  ensures none
  effects none
{
  return kind_of_lines(pkt_decode_section(&s.as_bytes()));
}

fn test_pkt() -> Bool
  intent "pkt-line の符号化・復号の正常例と不正例を試す"
  requires none
  ensures none
  effects console
{
  let mut ok = true;
  // 符号化
  ok = expect(match pkt_encode_str(&"hello\n") {
    Ok(b) => text_of(&b) == "000ahello\n",
    Err(_) => false,
  }, &"pkt: encode hello") && ok;
  ok = expect(text_of(&pkt_flush()) == "0000", &"pkt: flush") && ok;
  ok = expect(kind_of_bytes(pkt_encode(&Bytes.new())) == "Corrupt", &"pkt: empty payload is rejected") && ok;
  // 長さの境界: 4 桁を含めて 65520 まで
  let max_payload = max_pkt_line_len() - 4;
  ok = expect(match pkt_encode(&rep(&"x", max_payload).as_bytes()) {
    Ok(b) => b.len() == 65520 && text_of(&b.slice(0, 4).unwrap_or(Bytes.new())) == "fff0",
    Err(_) => false,
  }, &"pkt: 65520 bytes is accepted") && ok;
  ok = expect(kind_of_bytes(pkt_encode(&rep(&"x", max_payload + 1).as_bytes())) == "LimitExceeded", &"pkt: 65521 bytes is rejected") && ok;
  // 復号の正常例
  ok = expect(match pkt_decode_section(&"000ahello\n0000".as_bytes()) {
    Ok(ls) => ls.len() == 1 && item_text(&ls, 0) == "hello\n",
    Err(_) => false,
  }, &"pkt: decode one line") && ok;
  ok = expect(match pkt_decode_section(&"0000".as_bytes()) {
    Ok(ls) => ls.len() == 0,
    Err(_) => false,
  }, &"pkt: flush only") && ok;
  ok = expect(match pkt_decode_section(&"0006ab0006cd0000".as_bytes()) {
    Ok(ls) => ls.len() == 2 && item_text(&ls, 1) == "cd",
    Err(_) => false,
  }, &"pkt: two lines") && ok;
  // 復号の境界: 宣言が 65520 は受理、65521 は上限超過
  let big = cat3(&"fff0", &rep(&"y", 65516), &"0000");
  ok = expect(dec_kind(&big) == "ok", &"pkt: declared 65520 is accepted") && ok;
  ok = expect(dec_kind(&"fff1") == "LimitExceeded", &"pkt: declared 65521 is rejected") && ok;
  // 不正例
  ok = expect(dec_kind(&"") == "Corrupt", &"pkt: empty input has no flush") && ok;
  ok = expect(dec_kind(&"00") == "Corrupt", &"pkt: truncated length") && ok;
  ok = expect(dec_kind(&"zzzz") == "Corrupt", &"pkt: non-hex length") && ok;
  ok = expect(dec_kind(&"000Ahello\n0000") == "Corrupt", &"pkt: uppercase hex length") && ok;
  ok = expect(dec_kind(&"0003") == "Corrupt", &"pkt: length 0003") && ok;
  ok = expect(dec_kind(&"0004") == "Corrupt", &"pkt: empty payload 0004") && ok;
  ok = expect(dec_kind(&"000ahe") == "Corrupt", &"pkt: truncated payload") && ok;
  ok = expect(dec_kind(&"000ahello\n") == "Corrupt", &"pkt: missing flush") && ok;
  ok = expect(dec_kind(&"0000x") == "Corrupt", &"pkt: trailing data after flush") && ok;
  ok = expect(dec_kind(&"000ahello\n00000006ab") == "Corrupt", &"pkt: trailing line after flush") && ok;
  // v0 に無い特殊 pkt-line
  ok = expect(dec_kind(&"0001") == "UnsupportedFormat", &"pkt: delimiter-pkt") && ok;
  ok = expect(dec_kind(&"0002") == "UnsupportedFormat", &"pkt: response-end-pkt") && ok;
  ok = expect(dec_kind(&"000ahello\n0001") == "UnsupportedFormat", &"pkt: delimiter after data") && ok;
  ok = expect(dec_kind(&"0006ab00020000") == "UnsupportedFormat", &"pkt: response-end in the middle") && ok;
  return ok;
}

fn hid(c: &String) -> String
  intent "文字 c を 64 個並べた識別子を返す"
  requires none
  ensures none
  effects none
{
  return rep(&c, 64);
}

fn sample_refs() -> List<AdvRef>
  intent "試験用の参照の列を返す（ブランチ 2、注釈付きタグ 1、軽量タグ 1）"
  requires none
  ensures none
  effects none
{
  let mut r = List.new();
  r.push(new_adv_ref("refs/heads/main", hid(&"a"), None));
  r.push(new_adv_ref("refs/heads/topic", hid(&"b"), None));
  r.push(new_adv_ref("refs/tags/v1", hid(&"c"), Some(hid(&"d"))));
  r.push(new_adv_ref("refs/tags/v2", hid(&"e"), None));
  return r;
}

fn numbered_refs(n: Int, name_len: Int) -> List<AdvRef>
  intent "refs/heads/ の下に n 個の参照を昇順に作る。名前は 0 埋めの 4 桁の番号と x で name_len byte にそろえる"
  requires n >= 0 && n < 10000 && name_len >= 15
  ensures none
  effects none
{
  let mut r = List.new();
  let mut i = 0;
  while i < n {
    let stem = cat3(&"refs/heads/", &pad4(i), &"");
    let name = cat3(&stem, &rep(&"x", name_len - 15), &"");
    r.push(new_adv_ref(name, hid(&"a"), None));
    i = i + 1;
  }
  return r;
}

fn test_advertise() -> Bool
  intent "能力広告の形（upload-pack・receive-pack・空・peeled 行・HEAD と symref）を試す"
  requires none
  ensures none
  effects console
{
  let mut ok = true;
  let a = hid(&"a");
  let up_caps = "object-format=sha256 symref=HEAD:refs/heads/main side-band-64k";
  // upload-pack: HEAD・symref・peeled 行
  let l1 = lines_of(advertise_upload_pack(&sample_refs(), &Some(a.clone()), &Some("refs/heads/main")));
  ok = expect(l1.len() == 6, &"adv: upload-pack line count") && ok;
  ok = expect(line_at(&l1, 0) == cat3(&a, &" HEAD\u{0}object-format=sha256 symref=HEAD:refs/heads/main side-band-64k\n", &""), &"adv: HEAD line carries the capabilities") && ok;
  ok = expect(line_at(&l1, 1) == cat3(&a, &" refs/heads/main\n", &""), &"adv: branch line") && ok;
  ok = expect(line_at(&l1, 3) == cat3(&hid(&"c"), &" refs/tags/v1\n", &""), &"adv: annotated tag line") && ok;
  ok = expect(line_at(&l1, 4) == cat3(&hid(&"d"), &" refs/tags/v1^{}\n", &""), &"adv: peeled line follows the annotated tag") && ok;
  ok = expect(line_at(&l1, 5) == cat3(&hid(&"e"), &" refs/tags/v2\n", &""), &"adv: lightweight tag has no peeled line") && ok;
  // upload-pack: 分離 HEAD（symref なし）
  let l2 = lines_of(advertise_upload_pack(&sample_refs(), &Some(a.clone()), &None));
  ok = expect(line_at(&l2, 0) == cat3(&a, &" HEAD\u{0}object-format=sha256 side-band-64k\n", &""), &"adv: detached HEAD has no symref") && ok;
  // upload-pack: HEAD 無し（生まれていないブランチ）でも先頭の参照に能力が付く
  let l3 = lines_of(advertise_upload_pack(&sample_refs(), &None, &None));
  ok = expect(l3.len() == 5 && line_at(&l3, 0) == cat3(&a, &" refs/heads/main\u{0}object-format=sha256 side-band-64k\n", &""), &"adv: first ref carries the capabilities without HEAD") && ok;
  // upload-pack: 空のリポジトリ
  let l4 = lines_of(advertise_upload_pack(&List.new(), &None, &None));
  ok = expect(l4.len() == 1 && line_at(&l4, 0) == cat3(&hid(&"0"), &" capabilities^{}\u{0}object-format=sha256 side-band-64k\n", &""), &"adv: empty repository uses the zero id and capabilities^{}") && ok;
  // receive-pack: HEAD・symref・peeled 行は無い
  let rcaps = "object-format=sha256 report-status ofs-delta";
  let l5 = lines_of(advertise_receive_pack(&sample_refs()));
  ok = expect(l5.len() == 4, &"adv: receive-pack has no peeled lines or HEAD") && ok;
  ok = expect(line_at(&l5, 0) == cat3(&a, &" refs/heads/main\u{0}object-format=sha256 report-status ofs-delta\n", &""), &"adv: receive-pack first line") && ok;
  ok = expect(line_at(&l5, 2) == cat3(&hid(&"c"), &" refs/tags/v1\n", &""), &"adv: receive-pack tag line") && ok;
  let l6 = lines_of(advertise_receive_pack(&List.new()));
  ok = expect(l6.len() == 1 && line_at(&l6, 0) == cat3(&hid(&"0"), &" capabilities^{}\u{0}object-format=sha256 report-status ofs-delta\n", &""), &"adv: receive-pack empty repository") && ok;
  ok = expect(receive_pack_capabilities() == rcaps, &"adv: receive-pack capabilities") && ok;
  ok = expect(upload_pack_capabilities(&Some("refs/heads/main")) == up_caps, &"adv: upload-pack capabilities") && ok;
  // 実装していない能力は広告しない
  let names = words(&"multi_ack thin-pack shallow deepen filter no-done include-tag agent push-options atomic delete-refs allow-");
  let mut i = 0;
  while i < names.len() {
    let w = line_at(&names, i);
    if contains(&up_caps, &w) || contains(&rcaps, &w) {
      ok = fail(&cat3(&"adv: advertises an unimplemented capability: ", &w, &""));
    }
    i = i + 1;
  }
  ok = expect(!contains(&up_caps, &"side-band ") && !contains(&up_caps, &"report-status") && !contains(&rcaps, &"side-band") && !contains(&rcaps, &"symref"), &"adv: capabilities do not cross services") && ok;
  return ok;
}

fn test_advertise_rejections() -> Bool
  intent "広告に渡す参照の不正（昇順でない・重複・peeled の誤用・不正な識別子と名前・symref の誤用）の拒否を試す"
  requires none
  ensures none
  effects console
{
  let mut ok = true;
  let a = hid(&"a");
  let b = hid(&"b");
  let mut unsorted = List.new();
  unsorted.push(new_adv_ref("refs/heads/topic", b.clone(), None));
  unsorted.push(new_adv_ref("refs/heads/main", a.clone(), None));
  ok = expect(kind_of_bytes(advertise_upload_pack(&unsorted, &None, &None)) == "Corrupt", &"adv: unsorted refs (upload-pack)") && ok;
  ok = expect(kind_of_bytes(advertise_receive_pack(&unsorted)) == "Corrupt", &"adv: unsorted refs (receive-pack)") && ok;
  let mut dup = List.new();
  dup.push(new_adv_ref("refs/heads/main", a.clone(), None));
  dup.push(new_adv_ref("refs/heads/main", b.clone(), None));
  ok = expect(kind_of_bytes(advertise_upload_pack(&dup, &None, &None)) == "Corrupt", &"adv: duplicate refs") && ok;
  let mut peel_branch = List.new();
  peel_branch.push(new_adv_ref("refs/heads/main", a.clone(), Some(b.clone())));
  ok = expect(kind_of_bytes(advertise_upload_pack(&peel_branch, &None, &None)) == "Corrupt", &"adv: peeled line on a branch") && ok;
  let mut bad_id = List.new();
  bad_id.push(new_adv_ref("refs/heads/main", "xyz", None));
  ok = expect(kind_of_bytes(advertise_upload_pack(&bad_id, &None, &None)) == "Corrupt", &"adv: invalid id") && ok;
  let mut bad_peeled = List.new();
  bad_peeled.push(new_adv_ref("refs/tags/v1", a.clone(), Some("zz")));
  ok = expect(kind_of_bytes(advertise_upload_pack(&bad_peeled, &None, &None)) == "Corrupt", &"adv: invalid peeled id") && ok;
  let mut bad_name = List.new();
  bad_name.push(new_adv_ref("refs/heads/a..b", a.clone(), None));
  ok = expect(kind_of_bytes(advertise_upload_pack(&bad_name, &None, &None)) == "InvalidRefName", &"adv: invalid ref name") && ok;
  let mut other_ns = List.new();
  other_ns.push(new_adv_ref("refs/notes/x", a.clone(), None));
  ok = expect(kind_of_bytes(advertise_upload_pack(&other_ns, &None, &None)) == "InvalidRefName", &"adv: ref outside heads and tags") && ok;
  ok = expect(kind_of_bytes(advertise_upload_pack(&sample_refs(), &None, &Some("refs/heads/main"))) == "Corrupt", &"adv: symref without HEAD") && ok;
  ok = expect(kind_of_bytes(advertise_upload_pack(&sample_refs(), &Some(a.clone()), &Some("refs/tags/v1"))) == "Corrupt", &"adv: symref outside refs/heads") && ok;
  ok = expect(kind_of_bytes(advertise_upload_pack(&sample_refs(), &Some("nothex"), &None)) == "Corrupt", &"adv: invalid HEAD id") && ok;
  return ok;
}

fn test_advertise_limits() -> Bool
  intent "参照数 1024 と応答 1 MiB の直下・一致・超過を試す"
  requires none
  ensures none
  effects console
{
  let mut ok = true;
  let a = hid(&"a");
  // 参照数: 1024 は通り、1025 は拒否（HEAD も数える）
  let n = max_advertised_refs();
  ok = expect(kind_of_bytes(advertise_upload_pack(&numbered_refs(n, 40), &None, &None)) == "ok", &"limit: 1024 refs") && ok;
  ok = expect(kind_of_bytes(advertise_upload_pack(&numbered_refs(n + 1, 40), &None, &None)) == "LimitExceeded", &"limit: 1025 refs") && ok;
  ok = expect(kind_of_bytes(advertise_upload_pack(&numbered_refs(n - 1, 40), &Some(a.clone()), &None)) == "ok", &"limit: 1023 refs + HEAD") && ok;
  ok = expect(kind_of_bytes(advertise_upload_pack(&numbered_refs(n, 40), &Some(a.clone()), &None)) == "LimitExceeded", &"limit: 1024 refs + HEAD counts as 1025") && ok;
  ok = expect(kind_of_bytes(advertise_receive_pack(&numbered_refs(n, 40))) == "ok", &"limit: receive-pack 1024 refs") && ok;
  ok = expect(kind_of_bytes(advertise_receive_pack(&numbered_refs(n + 1, 40))) == "LimitExceeded", &"limit: receive-pack 1025 refs") && ok;
  // 応答 1 MiB: 長い名前の参照を重ねて、ちょうど 1048576 byte の広告と、1 byte 超える広告を作る
  let limit = max_transfer_response_size();
  let name_len = 1000;
  let len1 = match advertise_receive_pack(&numbered_refs(1, name_len)) {
    Ok(b) => b.len(),
    Err(_) => 0,
  };
  let len2 = match advertise_receive_pack(&numbered_refs(2, name_len)) {
    Ok(b) => b.len(),
    Err(_) => 0,
  };
  let line = len2 - len1;
  ok = expect(line > 1000 && len1 > 1000, &"limit: measured line sizes") && ok;
  // k 個で収まる最大の個数
  let mut k = (limit - len1) / line + 1;
  let mut fits = match advertise_receive_pack(&numbered_refs(k, name_len)) {
    Ok(b) => b.len(),
    Err(_) => 0,
  };
  while fits == 0 && k > 1 {
    k = k - 1;
    fits = match advertise_receive_pack(&numbered_refs(k, name_len)) {
      Ok(b) => b.len(),
      Err(_) => 0,
    };
  }
  ok = expect(fits > 0 && fits <= limit, &"limit: k refs fit under 1 MiB") && ok;
  ok = expect(kind_of_bytes(advertise_receive_pack(&numbered_refs(k + 1, name_len))) == "LimitExceeded", &"limit: k+1 refs exceed 1 MiB") && ok;
  // 最後の参照の名前の長さを調整して、ちょうど 1048576 byte にする
  let rest = limit - fits;
  let mut tuned = numbered_refs(k, name_len);
  // 末尾の参照の行は 4 + 64 + 1 + 名前 + 1 byte。名前は refs/heads/z... で 12 〜 1024 byte
  let tail_name_len = rest - 70;
  if tail_name_len >= 12 && tail_name_len <= 1024 {
    tuned.push(new_adv_ref(cat3(&"refs/heads/z", &rep(&"z", tail_name_len - 12), &""), a.clone(), None));
    ok = expect(match advertise_receive_pack(&tuned) {
      Ok(b) => b.len() == limit,
      Err(_) => false,
    }, &"limit: exactly 1048576 bytes is accepted") && ok;
    let mut over = numbered_refs(k, name_len);
    over.push(new_adv_ref(cat3(&"refs/heads/z", &rep(&"z", tail_name_len - 11), &""), a.clone(), None));
    ok = expect(kind_of_bytes(advertise_receive_pack(&over)) == "LimitExceeded", &"limit: 1048577 bytes is rejected") && ok;
  } else {
    ok = fail(&"limit: could not tune the tail ref to the exact limit") && ok;
  }
  return ok;
}

fn test_support_table() -> Bool
  intent "対応表（未対応の明記と既定の拒否）、クライアントが要求する能力の検査を試す"
  requires none
  ensures none
  effects console
{
  let mut ok = true;
  let sup = transfer_supported_features();
  let mut i = 0;
  while i < sup.len() {
    let n = line_at(&sup, i);
    ok = expect(kind_of_bool(check_transfer_feature(&n)) == "ok", &cat3(&"table: supported ", &n, &"")) && ok;
    i = i + 1;
  }
  let uns = transfer_unsupported_features();
  i = 0;
  while i < uns.len() {
    let n = line_at(&uns, i);
    ok = expect(kind_of_bool(check_transfer_feature(&n)) == "UnsupportedFormat", &cat3(&"table: unsupported ", &n, &"")) && ok;
    i = i + 1;
  }
  // Issue の未対応の一覧が対応表に残っている
  let must = words(&"protocol-v1 protocol-v2 object-format=sha1 ssh dumb-http thin-pack shallow deepen filter partial-clone allow-tip-sha1-in-want multi-ref-push atomic delete-refs force-push push-options push-cert lfs submodule-recursive hooks");
  let mut j = 0;
  while j < must.len() {
    let name = line_at(&must, j);
    let mut found = false;
    let mut k = 0;
    while k < uns.len() {
      if line_at(&uns, k) == name {
        found = true;
      }
      k = k + 1;
    }
    ok = expect(found, &cat3(&"table: ", &name, &" is listed as unsupported")) && ok;
    j = j + 1;
  }
  // 未知の名前も黙って成功しない
  ok = expect(kind_of_bool(check_transfer_feature(&"something-new")) == "UnsupportedFormat", &"table: unknown feature is rejected") && ok;
  ok = expect(kind_of_bool(check_transfer_feature(&"")) == "UnsupportedFormat", &"table: empty feature is rejected") && ok;
  // 要求された能力: 広告にあるものだけ
  let mut up_ok = List.new();
  up_ok.push("object-format=sha256");
  up_ok.push("side-band-64k");
  ok = expect(kind_of_bool(check_requested_capabilities(true, &up_ok)) == "ok", &"caps: upload-pack accepts its capabilities") && ok;
  let mut rp_ok = List.new();
  rp_ok.push("object-format=sha256");
  rp_ok.push("report-status");
  rp_ok.push("ofs-delta");
  ok = expect(kind_of_bool(check_requested_capabilities(false, &rp_ok)) == "ok", &"caps: receive-pack accepts its capabilities") && ok;
  let bad = words(&"report-status ofs-delta thin-pack side-band multi_ack no-done shallow deepen-since filter include-tag agent=git/2.43 symref=HEAD:refs/heads/main object-format=sha1 atomic push-options");
  let mut m = 0;
  while m < bad.len() {
    let c = line_at(&bad, m);
    let mut one = List.new();
    one.push(c.clone());
    ok = expect(kind_of_bool(check_requested_capabilities(true, &one)) == "UnsupportedFormat", &cat3(&"caps: upload-pack rejects ", &c, &"")) && ok;
    m = m + 1;
  }
  let bad_rp = words(&"side-band-64k thin-pack side-band atomic push-options push-cert quiet delete-refs object-format=sha1");
  m = 0;
  while m < bad_rp.len() {
    let c = line_at(&bad_rp, m);
    let mut one = List.new();
    one.push(c.clone());
    ok = expect(kind_of_bool(check_requested_capabilities(false, &one)) == "UnsupportedFormat", &cat3(&"caps: receive-pack rejects ", &c, &"")) && ok;
    m = m + 1;
  }
  return ok;
}

pub fn run_transfer_tests() -> Bool
  intent "pkt-line・能力広告・対応表の全テストを実行し全合格なら true を返す"
  requires none
  ensures none
  effects console
{
  let mut ok = true;
  console.log(&"  pkt-line");
  ok = test_pkt() && ok;
  console.log(&"  advertisement");
  ok = test_advertise() && ok;
  console.log(&"  advertisement rejections");
  ok = test_advertise_rejections() && ok;
  console.log(&"  advertisement limits");
  ok = test_advertise_limits() && ok;
  console.log(&"  support table");
  ok = test_support_table() && ok;
  return ok;
}
