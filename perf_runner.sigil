module perf_runner
  targets server
  trust none

use git.checkout.checkout;
use git.fsio.cat3;
use git.fsio.create_synced_file;
use git.fsio.join_path;
use git.fsio.random_hex;
use git.object.ObjectType;
use git.odb.odb_read;
use git.odb.odb_write;
use git.ops.add_paths;
use git.ops.commit;
use git.ops.new_ident;
use git.repo.init_repo;
use git.walk.log;

fn int_to_str(val: Int) -> String
  intent "整数を文字列に変換する"
  requires none
  ensures none
  effects none
{
  if val == 0 {
    return "0";
  }
  let mut v = val;
  let mut digits = Bytes.new();
  while v > 0 {
    digits.push(48 + v % 10);
    v = v / 10;
  }
  let mut rev = Bytes.new();
  let mut i = digits.len();
  while i > 0 {
    rev.push(digits.get(i - 1).unwrap_or(0));
    i = i - 1;
  }
  return rev.to_string_utf8().unwrap_or("0");
}

pub fn run_perf(count: Int) -> Int
  intent "指定件数でオブジェクト書込・読取・log・diff・checkout を実行する"
  requires count > 0
  ensures none
  effects console, fs, random
{
  let test_root = join_path(&"tmp", &cat3(&"perf_repo_", &random_hex(6).unwrap_or("000000"), &""));
  let init_br = "main";
  let mut repo_opt = None;
  match init_repo(&test_root, false, &init_br) {
    Err(_) => {
      console.log(&"FAIL: init_repo");
      return 1;
    }
    Ok(r) => {
      repo_opt = Some(r);
    }
  }
  match repo_opt {
    None => {
      return 1;
    }
    Some(repo) => {
      // 1. オブジェクト書き込み (write)
      let mut ids = List.new();
      let mut i = 0;
      while i < count {
        let mut payload = Bytes.new();
        payload.extend(&cat3(&"perf object payload #", &int_to_str(i), &"\n").as_bytes());
        match odb_write(&repo, &ObjectType.Blob, &payload) {
          Err(_) => {
            console.log(&"FAIL: odb_write in perf");
            return 2;
          }
          Ok(id) => {
            ids.push(id);
          }
        }
        i = i + 1;
      }

      // 2. オブジェクト読み取り (read)
      i = 0;
      while i < ids.len() {
        match ids.get(i) {
          None => {}
          Some(id) => {
            match odb_read(&repo, &id) {
              Err(_) => {
                console.log(&"FAIL: odb_read in perf");
                return 3;
              }
              Ok(_) => {}
            }
          }
        }
        i = i + 1;
      }

      // 3. コミット履歴 (commit & log)
      let mut last_commit_id = "";
      i = 0;
      while i < count && i < 20 {
        let file_rel = cat3(&"perf_file_", &int_to_str(i), &".txt");
        let file_path = join_path(&repo.work_dir, &file_rel);
        let mut data = Bytes.new();
        data.extend(&cat3(&"commit content #", &int_to_str(i), &"\n").as_bytes());
        let _ = create_synced_file(&file_path, &data);
        let mut paths = List.new();
        paths.push(file_rel);
        let _ = add_paths(&repo, &paths);
        let author = new_ident("Perf", "perf@example.com", 1700000000 + i, "+0000");
        let committer = new_ident("Perf", "perf@example.com", 1700000000 + i, "+0000");
        let mut msg = Bytes.new();
        msg.extend(&cat3(&"perf commit #", &int_to_str(i), &"\n").as_bytes());
        match commit(&repo, &author, &committer, &msg) {
          Err(_) => {
            console.log(&"FAIL: commit in perf");
            return 4;
          }
          Ok(cid) => {
            last_commit_id = cid;
          }
        }
        i = i + 1;
      }

      // log 走査
      if last_commit_id != "" {
        match log(&repo, &last_commit_id) {
          Err(_) => {
            console.log(&"FAIL: log in perf");
            return 5;
          }
          Ok(_) => {}
        }
      }

      // 4. checkout
      if last_commit_id != "" {
        match checkout(&repo, &last_commit_id) {
          Err(_) => {
            console.log(&"FAIL: checkout in perf");
            return 6;
          }
          Ok(_) => {}
        }
      }
    }
  }

  console.log(&"perf run completed");
  return 0;
}

pub fn main() -> Int
  intent "標準規模での性能測定の入口"
  requires none
  ensures none
  effects console, fs, random
{
  return run_perf(50);
}

pub fn small() -> Int
  intent "評価器向けの小規模な性能測定の入口"
  requires none
  ensures none
  effects console, fs, random
{
  return run_perf(10);
}
