module git.tree
  targets server
  trust none

use git.error.GitError;
use git.limits.max_tree_entries;
use git.limits.max_tree_size;

pub struct TreeEntry {
  mode: Int,
  name: Bytes,
  id: Bytes,
}

pub fn new_tree_entry(mode: Int, name: Bytes, id: Bytes) -> TreeEntry
  intent "TreeEntry を構築する"
  requires id.byte_len() == 32
  ensures none
  effects none
{
  return TreeEntry { mode: mode, name: name, id: id };
}

pub fn new_tree_entry_str(mode: Int, name: String, id: Bytes) -> TreeEntry
  intent "文字列の名前から TreeEntry を構築する"
  requires id.byte_len() == 32
  ensures none
  effects none
{
  return TreeEntry { mode: mode, name: name.as_bytes(), id: id };
}

pub fn entry_mode(e: &TreeEntry) -> Int
  intent "TreeEntry のモードを返す"
  requires none
  ensures none
  effects none
{
  return e.mode;
}

pub fn entry_name(e: &TreeEntry) -> Bytes
  intent "TreeEntry の名前（バイト列）を返す"
  requires none
  ensures none
  effects none
{
  return e.name.clone();
}

pub fn entry_name_str(e: &TreeEntry) -> String
  intent "TreeEntry の名前を UTF-8 文字列として返す (非 UTF-8 時は空文字)"
  requires none
  ensures none
  effects none
{
  return e.name.to_string_utf8().unwrap_or("");
}

pub fn entry_id(e: &TreeEntry) -> Bytes
  intent "TreeEntry の識別子 (32 バイト) を返す"
  requires none
  ensures result.byte_len() == 32
  effects none
{
  return e.id.clone();
}

pub fn is_valid_mode(mode: Int) -> Bool
  intent "Git の tree エントリの有効なモードかどうか判定する"
  requires none
  ensures none
  effects none
{
  return mode == 100644 || mode == 100755 || mode == 40000 || mode == 120000 || mode == 160000;
}

pub fn is_dir_mode(mode: Int) -> Bool
  intent "ディレクトリ (木) のモードかどうか判定する"
  requires none
  ensures none
  effects none
{
  return mode == 40000;
}

pub fn validate_tree_name(name_bytes: &Bytes) -> Result<Bool, GitError>
  intent "ADR 0047 決定 1 に従い tree エントリの名前（空でないこと、/ や NUL を含まないこと）を検査する"
  requires none
  ensures none
  effects none
{
  let len = name_bytes.byte_len();
  if len == 0 {
    return Err(GitError.Corrupt("tree entry name cannot be empty"));
  }
  let mut i = 0;
  while i < len {
    let b = name_bytes.get(i).unwrap_or(0);
    if b == 47 {
      return Err(GitError.Corrupt("tree entry name cannot contain slash"));
    }
    if b == 0 {
      return Err(GitError.Corrupt("tree entry name cannot contain null byte"));
    }
    i = i + 1;
  }
  return Ok(true);
}

pub fn compare_tree_entries(name_a: &Bytes, mode_a: Int, name_b: &Bytes, mode_b: Int) -> Int
  intent "tree エントリの並び順を比較する（ディレクトリは末尾に / があるものとして比較）"
  requires none
  ensures none
  effects none
{
  let mut ba = name_a.clone();
  if mode_a == 40000 {
    ba.push(47);  // '/'
  }
  let mut bb = name_b.clone();
  if mode_b == 40000 {
    bb.push(47);  // '/'
  }

  let len_a = ba.byte_len();
  let len_b = bb.byte_len();
  let mut min_len = len_a;
  if len_b < min_len {
    min_len = len_b;
  }

  let mut i = 0;
  while i < min_len {
    let ca = ba.get(i).unwrap_or(0);
    let cb = bb.get(i).unwrap_or(0);
    if ca < cb {
      return 0 - 1;
    }
    if ca > cb {
      return 1;
    }
    i = i + 1;
  }

  if len_a < len_b {
    return 0 - 1;
  }
  if len_a > len_b {
    return 1;
  }
  return 0;
}

pub fn decode_tree(content: &Bytes) -> Result<List<TreeEntry>, GitError>
  intent "tree オブジェクトの内容をパースしエントリ一覧を返す"
  requires none
  ensures none
  effects none
{
  let total_len = content.byte_len();
  if total_len > max_tree_size() {
    return Err(GitError.LimitExceeded("tree object size exceeds 16 MiB limit"));
  }

  let mut entries = List.new();
  let mut pos = 0;
  let mut has_prev = false;
  let mut prev_name = Bytes.new();
  let mut prev_mode = 0;

  while pos < total_len {
    // 1. スペースを探してモードをパース
    let mut sp_pos = 0 - 1;
    let mut i = pos;
    while i < total_len && sp_pos < 0 {
      if content.get(i).unwrap_or(0) == 32 {
        sp_pos = i;
      }
      i = i + 1;
    }
    if sp_pos <= pos {
      return Err(GitError.Corrupt("invalid tree entry: missing space after mode"));
    }

    let mode_len = sp_pos - pos;
    // 桁数制限: 正規形は 5 桁 (40000) または 6 桁 (100644, 100755, 120000, 160000) のみ
    if mode_len < 5 || mode_len > 6 {
      return Err(GitError.Corrupt("invalid tree entry mode: length must be 5 or 6 digits"));
    }

    // 先頭 0 のモードは非正規形のため拒否 (040000, 0100644 等)
    if content.get(pos).unwrap_or(0) == 48 {
      return Err(GitError.Corrupt("invalid tree entry mode: leading zero is not allowed"));
    }

    let mut mode = 0;
    let mut p = pos;
    while p < sp_pos {
      let b = content.get(p).unwrap_or(0);
      if b < 48 || b > 55 {
        return Err(GitError.Corrupt("invalid tree entry mode: non-octal character"));
      }
      mode = mode * 10 + (b - 48);
      p = p + 1;
    }

    if !is_valid_mode(mode) {
      return Err(GitError.Corrupt("unsupported or invalid tree entry mode"));
    }
    // 正規形桁数との整合検査
    if mode == 40000 && mode_len != 5 {
      return Err(GitError.Corrupt("invalid tree entry mode: directory mode must be 5 digits (40000)"));
    }
    if mode != 40000 && mode_len != 6 {
      return Err(GitError.Corrupt("invalid tree entry mode: non-directory mode must be 6 digits"));
    }

    // 2. NUL バイトを探して名前を取得
    let mut null_pos = 0 - 1;
    i = sp_pos + 1;
    while i < total_len && null_pos < 0 {
      if content.get(i).unwrap_or(0) == 0 {
        null_pos = i;
      }
      i = i + 1;
    }
    if null_pos <= sp_pos + 1 {
      return Err(GitError.Corrupt("invalid tree entry: missing null terminator after name"));
    }

    let name_bytes = content.slice(sp_pos + 1, null_pos).unwrap_or(Bytes.new());
    validate_tree_name(&name_bytes)?;

    // 3. 識別子 (SHA-256: 32 バイト) を取得
    let id_start = null_pos + 1;
    if id_start + 32 > total_len {
      return Err(GitError.Corrupt("truncated tree entry: missing 32-byte sha-256 id"));
    }
    let id = content.slice(id_start, id_start + 32).unwrap_or(Bytes.new());

    // 4. ソート順序と重複の検証
    if has_prev {
      let cmp = compare_tree_entries(&prev_name, prev_mode, &name_bytes, mode);
      if cmp == 0 {
        return Err(GitError.Corrupt("duplicate entry in tree"));
      }
      if cmp > 0 {
        return Err(GitError.Corrupt("tree entries not sorted"));
      }
    }

    has_prev = true;
    prev_name = name_bytes.clone();
    prev_mode = mode;

    entries.push(new_tree_entry(mode, name_bytes, id));
    if entries.len() > max_tree_entries() {
      return Err(GitError.LimitExceeded("tree entry count exceeds 100000 limit"));
    }

    pos = id_start + 32;
  }

  return Ok(entries);
}

fn mode_to_octal_bytes(mode: Int) -> Bytes
  intent "モード数値を Git 形式の文字列 (100644, 40000 など) に変換する"
  requires mode > 0
  ensures none
  effects none
{
  let mut m = mode;
  let mut digits = Bytes.new();
  while m > 0 {
    digits.push(48 + m % 10);
    m = m / 10;
  }
  let mut res = Bytes.new();
  let mut i = digits.byte_len() - 1;
  while i >= 0 {
    res.push(digits.get(i).unwrap_or(48));
    i = i - 1;
  }
  return res;
}

pub fn encode_tree(entries: &List<TreeEntry>) -> Result<Bytes, GitError>
  intent "TreeEntry の一覧から tree オブジェクトの内容バイト列を符号化する"
  requires none
  ensures none
  effects none
{
  let count = entries.len();
  if count > max_tree_entries() {
    return Err(GitError.LimitExceeded("tree entry count exceeds 100000 limit"));
  }

  let mut buf = Bytes.new();
  let mut has_prev = false;
  let mut prev_name = Bytes.new();
  let mut prev_mode = 0;

  let mut i = 0;
  while i < count {
    match entries.get(i) {
      Some(entry) => {
        let mode = entry_mode(&entry);
        let name = entry_name(&entry);
        let id = entry_id(&entry);

        if !is_valid_mode(mode) {
          return Err(GitError.Corrupt("invalid mode in tree entry"));
        }
        validate_tree_name(&name)?;
        if id.byte_len() != 32 {
          return Err(GitError.Corrupt("tree entry id must be 32 bytes"));
        }

        if has_prev {
          let cmp = compare_tree_entries(&prev_name, prev_mode, &name, mode);
          if cmp == 0 {
            return Err(GitError.Corrupt("duplicate entry in tree"));
          }
          if cmp > 0 {
            return Err(GitError.Corrupt("tree entries must be sorted"));
          }
        }

        has_prev = true;
        prev_name = name.clone();
        prev_mode = mode;

        let mode_bytes = mode_to_octal_bytes(mode);
        buf.extend(&mode_bytes);
        buf.push(32);  // ' '
        buf.extend(&name);
        buf.push(0);  // '\0'
        buf.extend(&id);

        if buf.byte_len() > max_tree_size() {
          return Err(GitError.LimitExceeded("tree encoded size exceeds 16 MiB limit"));
        }
      }
      None => {}
    }
    i = i + 1;
  }

  return Ok(buf);
}
