module git.validate
  targets server
  trust none

use git.error.GitError;
use git.limits.max_path_component_len;
use git.limits.max_path_depth;
use git.limits.max_path_total_len;
use git.limits.max_ref_name_len;

fn to_lower_byte(c: Int) -> Int
  intent "ASCII 文字を小文字にする"
  requires none
  ensures none
  effects none
{
  if c >= 65 && c <= 90 {
    return c + 32;
  }
  return c;
}

fn strip_hfs_ignored_chars(bytes: &Bytes) -> Bytes
  intent "HFS+ で無視される Unicode 制御文字 (U+200C-U+200F, U+202A-U+202E, U+206A-U+206F, U+FEFF) を除去する"
  requires none
  ensures none
  effects none
{
  let len = bytes.len();
  let mut out = Bytes.new();
  let mut i = 0;
  while i < len {
    let b0 = bytes.get(i).unwrap_or(0);
    let mut skip = 0;
    if b0 == 239 && i + 2 < len {
      // 0xEF 0xBB 0xBF (U+FEFF)
      let b1 = bytes.get(i + 1).unwrap_or(0);
      let b2 = bytes.get(i + 2).unwrap_or(0);
      if b1 == 187 && b2 == 191 {
        skip = 3;
      }
    } else if b0 == 226 && i + 2 < len {
      // 0xE2
      let b1 = bytes.get(i + 1).unwrap_or(0);
      let b2 = bytes.get(i + 2).unwrap_or(0);
      if b1 == 128 {
        // 0xE2 0x80 ...
        // 0x8C..0x8F (140..143): U+200C - U+200F
        // 0xAA..0xAE (170..174): U+202A - U+202E
        let is_range1 = b2 >= 140 && b2 <= 143;
        let is_range2 = b2 >= 170 && b2 <= 174;
        if is_range1 || is_range2 {
          skip = 3;
        }
      } else if b1 == 129 {
        // 0xE2 0x81 ...
        // 0xAA..0xAF (170..175): U+206A - U+206F
        if b2 >= 170 && b2 <= 175 {
          skip = 3;
        }
      }
    }

    if skip > 0 {
      i = i + skip;
    } else {
      out.push(b0);
      i = i + 1;
    }
  }
  return out;
}

pub fn is_git_dir_or_variant(bytes: &Bytes) -> Bool
  intent "パス構成要素が大文字小文字を問わず .git またはその変種（末尾ドット・空白、NTFS 代替ストリーム、NTFS 短い名前、HFS+ 無視文字等）か検査する"
  requires none
  ensures none
  effects none
{
  let stripped = strip_hfs_ignored_chars(&bytes);
  let len = stripped.len();
  if len < 4 {
    return false;
  }

  // 1. .git (4文字以上)
  let c0 = stripped.get(0).unwrap_or(0);
  let c1 = to_lower_byte(stripped.get(1).unwrap_or(0));
  let c2 = to_lower_byte(stripped.get(2).unwrap_or(0));
  let c3 = to_lower_byte(stripped.get(3).unwrap_or(0));

  if c0 == 46 && c1 == 103 && c2 == 105 && c3 == 116 {
    if len == 4 {
      return true;
    }
    // NTFS Alternate Data Streams (.git:foo, .git::$INDEX_ALLOCATION) または末尾ドット・空白 (.git., .git )
    let mut has_colon = false;
    let mut all_dot_or_space = true;
    let mut j = 4;
    while j < len {
      let b = stripped.get(j).unwrap_or(0);
      if b == 58 {
        has_colon = true;
      }
      if b != 46 && b != 32 {
        all_dot_or_space = false;
      }
      j = j + 1;
    }
    if has_colon || all_dot_or_space {
      return true;
    }
  }

  // 2. NTFS 短い名前: git~1, git~2 など (5文字以上)
  if len >= 5 {
    let g0 = to_lower_byte(stripped.get(0).unwrap_or(0));
    let g1 = to_lower_byte(stripped.get(1).unwrap_or(0));
    let g2 = to_lower_byte(stripped.get(2).unwrap_or(0));
    let g3 = stripped.get(3).unwrap_or(0);
    let g4 = stripped.get(4).unwrap_or(0);
    if g0 == 103 && g1 == 105 && g2 == 116 && g3 == 126 && (g4 >= 49 && g4 <= 57) {
      if len == 5 {
        return true;
      }
      let mut has_colon = false;
      let mut all_dot_or_space = true;
      let mut j = 5;
      while j < len {
        let b = stripped.get(j).unwrap_or(0);
        if b == 58 {
          has_colon = true;
        }
        if b != 46 && b != 32 {
          all_dot_or_space = false;
        }
        j = j + 1;
      }
      if has_colon || all_dot_or_space {
        return true;
      }
    }
  }

  return false;
}

pub fn validate_path(path: &String) -> Result<Bool, GitError>
  intent "ADR 0047 決定4 に従い、パスの安全性を検査する"
  requires none
  ensures none
  effects none
{
  let pb = path.as_bytes();
  let total_len = pb.len();
  if total_len == 0 {
    return Err(GitError.InvalidPath("path cannot be empty"));
  }
  if total_len > max_path_total_len() {
    return Err(GitError.LimitExceeded("path total length exceeds 4096 limit"));
  }

  // 絶対パス禁止
  if pb.get(0).unwrap_or(0) == 47 {
    return Err(GitError.InvalidPath("absolute path is not allowed"));
  }

  // バックスラッシュまたは NUL 禁止
  let mut i = 0;
  while i < total_len {
    let b = pb.get(i).unwrap_or(0);
    if b == 92 {
      return Err(GitError.InvalidPath("path cannot contain backslash"));
    }
    if b == 0 {
      return Err(GitError.InvalidPath("path cannot contain null byte"));
    }
    i = i + 1;
  }

  // 各構成要素（/ 区切り）の検査
  let mut depth = 0;
  let mut comp_start = 0;
  i = 0;

  while i <= total_len {
    let at_end = i == total_len;
    let is_slash = match at_end {
      true => false,
      false => pb.get(i).unwrap_or(0) == 47,
    };

    if at_end || is_slash {
      let comp_len = i - comp_start;
      if comp_len == 0 {
        return Err(GitError.InvalidPath("path contains empty component or trailing slash"));
      }
      if comp_len > max_path_component_len() {
        return Err(GitError.LimitExceeded("path component length exceeds 255 limit"));
      }

      let comp_bytes = pb.slice(comp_start, i).unwrap_or(Bytes.new());
      if comp_len == 1 && comp_bytes.get(0).unwrap_or(0) == 46 {
        return Err(GitError.InvalidPath("path component cannot be ."));
      }
      if comp_len == 2 && comp_bytes.get(0).unwrap_or(0) == 46 && comp_bytes.get(1).unwrap_or(0) == 46 {
        return Err(GitError.InvalidPath("path component cannot be .."));
      }
      if is_git_dir_or_variant(&comp_bytes) {
        return Err(GitError.InvalidPath("path component cannot be .git or variant"));
      }

      depth = depth + 1;
      if depth > max_path_depth() {
        return Err(GitError.LimitExceeded("path depth exceeds 128 limit"));
      }

      comp_start = i + 1;
    }
    i = i + 1;
  }

  return Ok(true);
}

pub fn validate_ref_name(ref_name: &String) -> Result<Bool, GitError>
  intent "Git の check-ref-format 規則に従い参照名を検査する"
  requires none
  ensures none
  effects none
{
  let rb = ref_name.as_bytes();
  let len = rb.len();
  if len == 0 {
    return Err(GitError.InvalidRefName("ref name cannot be empty"));
  }
  if len > max_ref_name_len() {
    return Err(GitError.LimitExceeded("ref name length exceeds 1024 limit"));
  }

  // 名前全体が @ 単体は禁止
  if ref_name == "@" {
    return Err(GitError.InvalidRefName("ref name cannot be single @"));
  }

  // 先頭または末尾が / 禁止
  if rb.get(0).unwrap_or(0) == 47 || rb.get(len - 1).unwrap_or(0) == 47 {
    return Err(GitError.InvalidRefName("ref name cannot begin or end with slash"));
  }

  let mut i = 0;
  while i < len {
    let b = rb.get(i).unwrap_or(0);
    // 制御文字 (ASCII < 32 または 127) 禁止
    if b < 32 || b == 127 {
      return Err(GitError.InvalidRefName("ref name cannot contain control characters"));
    }
    // 空白、~, ^, :, ?, *, [, \ 禁止
    if b == 32 || b == 126 || b == 94 || b == 58 || b == 63 || b == 42 || b == 91 || b == 92 {
      return Err(GitError.InvalidRefName("ref name contains invalid character"));
    }
    // 連続する / (//)
    if b == 47 && i + 1 < len && rb.get(i + 1).unwrap_or(0) == 47 {
      return Err(GitError.InvalidRefName("ref name cannot contain consecutive slashes"));
    }
    // .. 禁止
    if b == 46 && i + 1 < len && rb.get(i + 1).unwrap_or(0) == 46 {
      return Err(GitError.InvalidRefName("ref name cannot contain .."));
    }
    // @{ 禁止
    if b == 64 && i + 1 < len && rb.get(i + 1).unwrap_or(0) == 123 {
      return Err(GitError.InvalidRefName("ref name cannot contain @{"));
    }
    i = i + 1;
  }

  // 各構成要素（/ 区切り）の検査
  let mut comp_start = 0;
  i = 0;
  while i <= len {
    let at_end = i == len;
    let is_slash = match at_end {
      true => false,
      false => rb.get(i).unwrap_or(0) == 47,
    };

    if at_end || is_slash {
      let comp_len = i - comp_start;
      let comp_bytes = rb.slice(comp_start, i).unwrap_or(Bytes.new());

      // . で始まる構成要素禁止
      if comp_bytes.get(0).unwrap_or(0) == 46 {
        return Err(GitError.InvalidRefName("ref name component cannot begin with dot"));
      }

      // . で終わる構成要素禁止
      if comp_bytes.get(comp_len - 1).unwrap_or(0) == 46 {
        return Err(GitError.InvalidRefName("ref name component cannot end with dot"));
      }

      // 末尾が .lock で終わる構成要素禁止
      if comp_len >= 5 {
        let l0 = comp_bytes.get(comp_len - 5).unwrap_or(0);
        let l1 = comp_bytes.get(comp_len - 4).unwrap_or(0);
        let l2 = comp_bytes.get(comp_len - 3).unwrap_or(0);
        let l3 = comp_bytes.get(comp_len - 2).unwrap_or(0);
        let l4 = comp_bytes.get(comp_len - 1).unwrap_or(0);
        if l0 == 46 && l1 == 108 && l2 == 111 && l3 == 99 && l4 == 107 {
          return Err(GitError.InvalidRefName("ref name component cannot end with .lock"));
        }
      }

      comp_start = i + 1;
    }
    i = i + 1;
  }

  return Ok(true);
}
