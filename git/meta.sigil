module git.meta
  targets server
  trust none

use git.acl.repo_id_ok;
use git.acl.subject_name_ok;
use git.error.GitError;
use git.fsio.cat2;
use git.fsio.cat3;
use git.fsio.create_synced_file;
use git.fsio.dir_exists;
use git.fsio.file_exists;
use git.fsio.file_size;
use git.fsio.join_path;
use git.fsio.list_names;
use git.fsio.lock_create;
use git.fsio.make_dirs;
use git.fsio.open_read;
use git.fsio.random_hex;
use git.fsio.read_file_opt;
use git.fsio.remove_file_if_exists;
use git.fsio.rename_file;
use git.fsio.string_ends_with;
use git.fsio.sync_dir;
use git.hash.int_to_str;
use git.pack.open_pack;
use git.repo.init_repo;
use git.repo.open_repo;
use git.validate.validate_ref_name;

// ADR 0048 決定 3: リポジトリの metadata・ACL と永続化。
// repo id・owner／ACL・可視性・既定ブランチ・形式版を持つ上限付きファイルとし、
// 同じ repo 排他（sigil-receive.lock）の下で一時ファイル同期→同一 FS rename→親ディレクトリ同期で公開する。
// 不明版・破損・欠落時はサービス対象から外して拒否し、public の既定値で継続しない。

pub struct RepoMeta {
  id: String,
  version: Int,
  visibility: String,
  default_branch: String,
  owners: List<String>,
  writers: List<String>,
  readers: List<String>,
}

pub struct RepoUsage {
  object_count: Int,
  usage_bytes: Int,
  max_objects: Int,
  max_storage_bytes: Int,
}

pub fn empty_meta() -> RepoMeta
  intent "空の RepoMeta を返す"
  requires none
  ensures none
  effects none
{
  return RepoMeta { id: "", version: 0, visibility: "", default_branch: "", owners: List.new(), writers: List.new(), readers: List.new() };
}

pub fn new_meta(id: &String, version: Int, visibility: &String, default_branch: &String, owners: &List<String>, writers: &List<String>, readers: &List<String>) -> RepoMeta
  intent "RepoMeta を構築する"
  requires none
  ensures none
  effects none
{
  let mut own_copy = List.new();
  let mut i = 0;
  while i < owners.len() {
    match owners.get(i) {
      Some(v) => {
        own_copy.push(v.clone());
      }
      None => {}
    }
    i = i + 1;
  }
  let mut wr_copy = List.new();
  i = 0;
  while i < writers.len() {
    match writers.get(i) {
      Some(v) => {
        wr_copy.push(v.clone());
      }
      None => {}
    }
    i = i + 1;
  }
  let mut rd_copy = List.new();
  i = 0;
  while i < readers.len() {
    match readers.get(i) {
      Some(v) => {
        rd_copy.push(v.clone());
      }
      None => {}
    }
    i = i + 1;
  }
  return RepoMeta { id: id.clone(), version: version, visibility: visibility.clone(), default_branch: default_branch.clone(), owners: own_copy, writers: wr_copy, readers: rd_copy };
}

pub fn empty_usage() -> RepoUsage
  intent "空の RepoUsage を返す"
  requires none
  ensures none
  effects none
{
  return RepoUsage { object_count: 0, usage_bytes: 0, max_objects: 0, max_storage_bytes: 0 };
}

pub fn new_usage(object_count: Int, usage_bytes: Int, max_objects: Int, max_storage_bytes: Int) -> RepoUsage
  intent "RepoUsage を構築する"
  requires none
  ensures none
  effects none
{
  return RepoUsage { object_count: object_count, usage_bytes: usage_bytes, max_objects: max_objects, max_storage_bytes: max_storage_bytes };
}

pub fn max_metadata_size() -> Int
  intent "metadata ファイルの最大長（16 KiB）を返す"
  requires none
  ensures result == 16384
  effects none
{
  return 16384;
}

pub fn meta_file_path(git_dir: &String) -> String
  intent "リポジトリディレクトリ内の metadata ファイルのパスを返す"
  requires none
  ensures none
  effects none
{
  return join_path(&git_dir, &"sigil-metadata");
}

pub fn meta_lock_path(git_dir: &String) -> String
  intent "リポジトリの排他ロックのパスを返す（push と同じ sigil-receive.lock を共用して競合を防ぐ）"
  requires none
  ensures none
  effects none
{
  return join_path(&git_dir, &"sigil-receive.lock");
}

fn split_lines(b: &Bytes) -> List<String>
  intent "LF または CRLF で行に分割する"
  requires none
  ensures none
  effects none
{
  let mut lines = List.new();
  let mut cur = Bytes.new();
  let mut i = 0;
  while i < b.byte_len() {
    let c = b.get(i).unwrap_or(0);
    if c == 10 {
      if cur.byte_len() > 0 && cur.get(cur.byte_len() - 1).unwrap_or(0) == 13 {
        cur = cur.slice(0, cur.byte_len() - 1).unwrap_or(Bytes.new());
      }
      lines.push(cur.to_string_utf8().unwrap_or(""));
      cur = Bytes.new();
    } else {
      cur.push(c);
    }
    i = i + 1;
  }
  if cur.byte_len() > 0 {
    if cur.get(cur.byte_len() - 1).unwrap_or(0) == 13 {
      cur = cur.slice(0, cur.byte_len() - 1).unwrap_or(Bytes.new());
    }
    lines.push(cur.to_string_utf8().unwrap_or(""));
  }
  return lines;
}

fn split_comma(s: &String) -> List<String>
  intent "カンマで分割する（空要素は含めない）"
  requires none
  ensures none
  effects none
{
  let b = s.as_bytes();
  let mut out = List.new();
  let mut cur = Bytes.new();
  let mut i = 0;
  while i < b.byte_len() {
    let c = b.get(i).unwrap_or(0);
    if c == 44 {
      if cur.byte_len() > 0 {
        out.push(cur.to_string_utf8().unwrap_or(""));
      }
      cur = Bytes.new();
    } else {
      cur.push(c);
    }
    i = i + 1;
  }
  if cur.byte_len() > 0 {
    out.push(cur.to_string_utf8().unwrap_or(""));
  }
  return out;
}

fn join_comma(l: &List<String>) -> String
  intent "リストをカンマ区切りの文字列にする"
  requires none
  ensures none
  effects none
{
  let mut out = "";
  let mut i = 0;
  while i < l.len() {
    match l.get(i) {
      Some(s) => {
        if i > 0 {
          out = cat2(&out, &",");
        }
        out = cat2(&out, &s);
      }
      None => {}
    }
    i = i + 1;
  }
  return out;
}

pub fn is_in_list(l: &List<String>, s: &String) -> Bool
  intent "リストに文字列 s が含まれるかを返す"
  requires none
  ensures none
  effects none
{
  let mut i = 0;
  while i < l.len() {
    match l.get(i) {
      Some(item) => {
        if item == s {
          return true;
        }
      }
      None => {}
    }
    i = i + 1;
  }
  return false;
}

pub fn serialize_meta(meta: &RepoMeta) -> Bytes
  intent "RepoMeta をテキスト形式のバイト列に直列化する"
  requires none
  ensures none
  effects none
{
  let mut out = Bytes.new();
  let s_ver = cat3(&"version=", &int_to_str(meta.version), &"\n");
  out.extend(&s_ver.as_bytes());
  let s_id = cat3(&"id=", &meta.id, &"\n");
  out.extend(&s_id.as_bytes());
  let s_vis = cat3(&"visibility=", &meta.visibility, &"\n");
  out.extend(&s_vis.as_bytes());
  let s_def = cat3(&"default_branch=", &meta.default_branch, &"\n");
  out.extend(&s_def.as_bytes());
  let s_own = cat3(&"owners=", &join_comma(&meta.owners), &"\n");
  out.extend(&s_own.as_bytes());
  let s_wri = cat3(&"writers=", &join_comma(&meta.writers), &"\n");
  out.extend(&s_wri.as_bytes());
  let s_rea = cat3(&"readers=", &join_comma(&meta.readers), &"\n");
  out.extend(&s_rea.as_bytes());
  return out;
}

fn check_subject_list(l: &List<String>) -> Bool
  intent "すべての主体名が空でなく安全な文字か"
  requires none
  ensures none
  effects none
{
  let mut i = 0;
  while i < l.len() {
    match l.get(i) {
      Some(s) => {
        if !subject_name_ok(&s) {
          return false;
        }
      }
      None => {
        return false;
      }
    }
    i = i + 1;
  }
  return true;
}

fn check_no_empty_items_in_comma(s: &String) -> Bool
  intent "カンマ区切り文字列に空の項目（,, や先頭・末尾のカンマ）が無いか"
  requires none
  ensures none
  effects none
{
  let b = s.as_bytes();
  if b.byte_len() == 0 {
    return true;
  }
  if b.get(0).unwrap_or(0) == 44 || b.get(b.byte_len() - 1).unwrap_or(0) == 44 {
    return false;
  }
  let mut i = 0;
  while i + 1 < b.byte_len() {
    if b.get(i).unwrap_or(0) == 44 && b.get(i + 1).unwrap_or(0) == 44 {
      return false;
    }
    i = i + 1;
  }
  return true;
}

pub fn ref_name_safe(name: &String) -> Bool
  intent "ブランチ名として安全か（ダブルクオート、バックスラッシュ、空白、制御文字を含まない）"
  requires none
  ensures none
  effects none
{
  let b = name.as_bytes();
  if b.byte_len() == 0 || b.byte_len() > 255 {
    return false;
  }
  let mut i = 0;
  while i < b.byte_len() {
    let c = b.get(i).unwrap_or(0);
    if c <= 32 || c == 34 || c == 92 || c == 127 {
      return false;
    }
    i = i + 1;
  }
  return true;
}

pub fn parse_meta(data: &Bytes, expected_id: &String) -> Result<RepoMeta, String>
  intent "バイト列から RepoMeta を解読する。不明版・破損・空の主体・上限超過・id 不一致は Err"
  requires none
  ensures none
  effects none
{
  if data.byte_len() > max_metadata_size() {
    return Err("metadata_too_large");
  }
  let lines = split_lines(&data);
  let mut version = 0;
  let mut id = "";
  let mut visibility = "";
  let mut default_branch = "";
  let mut owners = List.new();
  let mut writers = List.new();
  let mut readers = List.new();
  let mut seen_version = false;
  let mut seen_id = false;
  let mut seen_visibility = false;
  let mut seen_default_branch = false;
  let mut seen_owners = false;
  let mut seen_writers = false;
  let mut seen_readers = false;

  let mut i = 0;
  while i < lines.len() {
    match lines.get(i) {
      Some(line) => {
        if line.byte_len() > 0 {
          let lb = line.as_bytes();
          let mut eq = 0 - 1;
          let mut j = 0;
          while j < lb.byte_len() {
            if lb.get(j).unwrap_or(0) == 61 && eq < 0 {
              eq = j;
            }
            j = j + 1;
          }
          if eq <= 0 {
            return Err("corrupted_metadata");
          }
          let key = lb.slice(0, eq).unwrap_or(Bytes.new()).to_string_utf8().unwrap_or("");
          let val = lb.slice(eq + 1, lb.byte_len()).unwrap_or(Bytes.new()).to_string_utf8().unwrap_or("");
          if key == "version" {
            if seen_version {
              return Err("corrupted_metadata");
            }
            seen_version = true;
            match val.parse_int() {
              Ok(v) => {
                version = v;
              }
              Err(_) => {
                return Err("corrupted_metadata");
              }
            }
          } else if key == "id" {
            if seen_id {
              return Err("corrupted_metadata");
            }
            seen_id = true;
            id = val;
          } else if key == "visibility" {
            if seen_visibility {
              return Err("corrupted_metadata");
            }
            seen_visibility = true;
            visibility = val;
          } else if key == "default_branch" {
            if seen_default_branch {
              return Err("corrupted_metadata");
            }
            seen_default_branch = true;
            default_branch = val;
          } else if key == "owners" {
            if seen_owners {
              return Err("corrupted_metadata");
            }
            seen_owners = true;
            if !check_no_empty_items_in_comma(&val) {
              return Err("corrupted_metadata");
            }
            owners = split_comma(&val);
          } else if key == "writers" {
            if seen_writers {
              return Err("corrupted_metadata");
            }
            seen_writers = true;
            if !check_no_empty_items_in_comma(&val) {
              return Err("corrupted_metadata");
            }
            writers = split_comma(&val);
          } else if key == "readers" {
            if seen_readers {
              return Err("corrupted_metadata");
            }
            seen_readers = true;
            if !check_no_empty_items_in_comma(&val) {
              return Err("corrupted_metadata");
            }
            readers = split_comma(&val);
          } else {
            return Err("corrupted_metadata");
          }
        }
      }
      None => {}
    }
    i = i + 1;
  }

  if !seen_version || !seen_id || !seen_visibility || !seen_default_branch || !seen_owners {
    return Err("corrupted_metadata");
  }
  if version != 1 {
    return Err("unknown_version");
  }
  if !repo_id_ok(&id) {
    return Err("invalid_id");
  }
  if expected_id.byte_len() > 0 && id != expected_id {
    return Err("invalid_id");
  }
  if visibility != "private" && visibility != "public-read" {
    return Err("invalid_visibility");
  }
  if default_branch.byte_len() == 0 || !ref_name_safe(&default_branch) || validate_ref_name(&cat3(&"refs/heads/", &default_branch, &"")).is_err() {
    return Err("invalid_default_branch");
  }
  if owners.len() < 1 {
    return Err("owner_required");
  }
  if !check_subject_list(&owners) || !check_subject_list(&writers) || !check_subject_list(&readers) {
    return Err("invalid_subject");
  }

  return Ok(RepoMeta { id: id, version: version, visibility: visibility, default_branch: default_branch, owners: owners, writers: writers, readers: readers });
}

pub fn load_meta(git_dir: &String, id: &String) -> Result<RepoMeta, String>
  intent "git ディレクトリ内の sigil-metadata を読む。存在しない・壊れている場合は Err"
  requires none
  ensures none
  effects fs.read
{
  let path = meta_file_path(&git_dir);
  let mut bytes = Bytes.new();
  match read_file_opt(&path, max_metadata_size() + 1, false) {
    Ok(opt) => {
      match opt {
        Some(b) => {
          bytes = b;
        }
        None => {
          return Err("missing_metadata");
        }
      }
    }
    Err(_) => {
      return Err("read_failed");
    }
  }
  return parse_meta(&bytes, &id);
}

pub fn save_meta_atomic(git_dir: &String, meta: &RepoMeta) -> Result<Bool, GitError>
  intent "一時ファイルへの書き込みと同期、rename、親ディレクトリの同期により原子的・安全に metadata を保存する"
  requires none
  ensures none
  effects fs, random
{
  let data = serialize_meta(&meta);
  if data.byte_len() > max_metadata_size() {
    return Err(GitError.LimitExceeded("metadata size exceeds limit"));
  }
  let final_path = meta_file_path(&git_dir);
  let tmp = cat3(&final_path, &".tmp-", &random_hex(8)?);
  create_synced_file(&tmp, &data)?;
  rename_file(&tmp, &final_path)?;
  sync_dir(&git_dir)?;
  return Ok(true);
}

pub fn can_read(meta: &RepoMeta, subject: &Option<String>) -> Bool
  intent "主体 subject がリポジトリを読めるか。public-read は匿名・全員可、private は owners/writers/readers に含まれる主体のみ"
  requires none
  ensures none
  effects none
{
  if meta.visibility == "public-read" {
    return true;
  }
  return match subject {
    Some(s) => is_in_list(&meta.owners, &s) || is_in_list(&meta.writers, &s) || is_in_list(&meta.readers, &s),
    None => false,
  };
}

pub fn can_write(meta: &RepoMeta, subject: &Option<String>) -> Bool
  intent "主体 subject がリポジトリへ書けるか（push）。owners または writers に含まれる認証済み主体のみ"
  requires none
  ensures none
  effects none
{
  return match subject {
    Some(s) => is_in_list(&meta.owners, &s) || is_in_list(&meta.writers, &s),
    None => false,
  };
}

pub fn can_manage(meta: &RepoMeta, subject: &Option<String>) -> Bool
  intent "主体 subject がリポジトリを管理できるか（ACL・可視性・既定ブランチの変更）。owners に含まれる主体のみ"
  requires none
  ensures none
  effects none
{
  return match subject {
    Some(s) => is_in_list(&meta.owners, &s),
    None => false,
  };
}

pub fn meta_can_read(meta: &RepoMeta, subject: &Option<String>) -> Bool
  intent "主体 subject がリポジトリを読めるか"
  requires none
  ensures none
  effects none
{
  return can_read(&meta, &subject);
}

pub fn meta_can_write(meta: &RepoMeta, subject: &Option<String>) -> Bool
  intent "主体 subject がリポジトリへ書けるか"
  requires none
  ensures none
  effects none
{
  return can_write(&meta, &subject);
}

pub fn meta_can_manage(meta: &RepoMeta, subject: &Option<String>) -> Bool
  intent "主体 subject がリポジトリを管理できるか"
  requires none
  ensures none
  effects none
{
  return can_manage(&meta, &subject);
}

fn remove_dir_rec(dir: &String) -> Result<Bool, GitError>
  intent "ディレクトリ内のファイルとサブディレクトリを再帰的に削除し、ディレクトリ自身も削除する"
  requires none
  ensures none
  effects fs
{
  if !dir_exists(&dir)? {
    if file_exists(&dir)? {
      remove_file_if_exists(&dir)?;
    }
    return Ok(true);
  }
  let names = list_names(&dir, 1000)?;
  let mut i = 0;
  while i < names.len() {
    match names.get(i) {
      Some(name) => {
        let p = join_path(&dir, &name);
        if dir_exists(&p)? {
          remove_dir_rec(&p)?;
        } else {
          remove_file_if_exists(&p)?;
        }
      }
      None => {}
    }
    i = i + 1;
  }
  return match fs.remove_dir(&Path.new(&dir)) {
    Ok(_) => Ok(true),
    Err(_) => Ok(false),
  };
}

fn dir_has_any_file(dir: &String) -> Result<Bool, GitError>
  intent "ディレクトリ配下に通常ファイルが存在するか再帰的に調べる（空ディレクトリのみなら false）"
  requires none
  ensures none
  effects fs
{
  if !dir_exists(&dir)? {
    return Ok(false);
  }
  let names = list_names(&dir, 1000)?;
  let mut i = 0;
  while i < names.len() {
    match names.get(i) {
      Some(name) => {
        let p = join_path(&dir, &name);
        if dir_exists(&p)? {
          if dir_has_any_file(&p)? {
            return Ok(true);
          }
        } else if file_exists(&p)? {
          return Ok(true);
        }
      }
      None => {}
    }
    i = i + 1;
  }
  return Ok(false);
}

fn repo_has_real_data(git_dir: &String) -> Result<Bool, GitError>
  intent "リポジトリ内に実体データ（packed-refs、objects 配下のファイル、refs 配下のファイル）が存在するか判定する"
  requires none
  ensures none
  effects fs
{
  if file_exists(&join_path(&git_dir, &"packed-refs"))? {
    return Ok(true);
  }
  let obj_dir = join_path(&git_dir, &"objects");
  if dir_has_any_file(&obj_dir)? {
    return Ok(true);
  }
  let refs_dir = join_path(&git_dir, &"refs");
  if dir_has_any_file(&refs_dir)? {
    return Ok(true);
  }
  return Ok(false);
}

pub fn create_repo_managed(root: &String, id: &String, owner: &String, default_branch: &String, admin_subject: &String, caller: &String) -> Result<RepoMeta, String>
  intent "起動設定の管理者のみがリポジトリを新規作成できる。作成時は private、owner は 1 人以上。同期が完了するまで一覧に出ない。排他ロック下で作成し実データは破壊しない"
  requires none
  ensures none
  effects fs, random
{
  if admin_subject.byte_len() == 0 || caller != admin_subject {
    return Err("forbidden");
  }
  if !repo_id_ok(&id) {
    return Err("invalid_id");
  }
  if !subject_name_ok(&owner) {
    return Err("invalid_owner");
  }
  let mut branch = default_branch.clone();
  if branch.byte_len() == 0 {
    branch = "main";
  }
  if !ref_name_safe(&branch) || validate_ref_name(&cat3(&"refs/heads/", &branch, &"")).is_err() {
    return Err("invalid_default_branch");
  }

  let create_lock_path = join_path(&root, &cat3(&id, &".lock", &""));
  match lock_create(&create_lock_path) {
    Ok(f) => {
      let _ = f.close();
    }
    Err(_) => {
      return Err("conflict");
    }
  }

  let r_id1 = cat3(&root, &"/", &id);
  let git_dir = cat3(&r_id1, &".git", &"");
  let has_head = file_exists(&join_path(&git_dir, &"HEAD")).unwrap_or(false);
  let has_dir = dir_exists(&git_dir).unwrap_or(false);
  if has_head || has_dir {
    if file_exists(&meta_file_path(&git_dir)).unwrap_or(false) {
      let _ = remove_file_if_exists(&create_lock_path);
      return Err("conflict");
    }
    if repo_has_real_data(&git_dir).unwrap_or(false) {
      let _ = remove_file_if_exists(&create_lock_path);
      return Err("conflict");
    }
    let _ = remove_dir_rec(&git_dir);
  }

  match init_repo(&git_dir, true, &branch) {
    Ok(_) => {}
    Err(e) => {
      let _ = remove_file_if_exists(&create_lock_path);
      return match e {
        GitError.AlreadyExists(_) => Err("conflict"),
        _ => Err("init_failed"),
      };
    }
  }

  let mut owners = List.new();
  owners.push(owner.clone());
  let meta = RepoMeta { id: id.clone(), version: 1, visibility: "private", default_branch: branch, owners: owners, writers: List.new(), readers: List.new() };

  match save_meta_atomic(&git_dir, &meta) {
    Ok(_) => {
      let _ = remove_file_if_exists(&create_lock_path);
      return Ok(meta);
    }
    Err(_) => {
      let _ = remove_dir_rec(&git_dir);
      let _ = remove_file_if_exists(&create_lock_path);
      return Err("storage_failure");
    }
  }
}

pub fn update_visibility_managed(root: &String, id: &String, new_vis: &String, caller: &String) -> Result<RepoMeta, String>
  intent "owner のみが可視性を変更できる。読取権限のない主体には 404（not_found）を返し存在を隠蔽する。排他ロック下で再検査・atomic 更新する"
  requires none
  ensures none
  effects fs, random
{
  if !repo_id_ok(&id) {
    return Err("not_found");
  }
  if new_vis != "private" && new_vis != "public-read" {
    return Err("invalid_visibility");
  }
  let r_id2 = cat3(&root, &"/", &id);
  let git_dir = cat3(&r_id2, &".git", &"");
  let mut cur_meta = empty_meta();
  match load_meta(&git_dir, &id) {
    Ok(m) => {
      cur_meta = m;
    }
    Err(_) => {
      return Err("not_found");
    }
  }
  if !can_read(&cur_meta, &Some(caller.clone())) {
    return Err("not_found");
  }
  if !can_manage(&cur_meta, &Some(caller.clone())) {
    return Err("forbidden");
  }

  let lock_path = meta_lock_path(&git_dir);
  match lock_create(&lock_path) {
    Ok(f) => {
      let _ = f.close();
    }
    Err(_) => {
      return Err("conflict");
    }
  }

  let mut locked_meta = empty_meta();
  match load_meta(&git_dir, &id) {
    Ok(m) => {
      locked_meta = m;
    }
    Err(_) => {
      let _ = remove_file_if_exists(&lock_path);
      return Err("not_found");
    }
  }
  if !can_read(&locked_meta, &Some(caller.clone())) {
    let _ = remove_file_if_exists(&lock_path);
    return Err("not_found");
  }
  if !can_manage(&locked_meta, &Some(caller.clone())) {
    let _ = remove_file_if_exists(&lock_path);
    return Err("forbidden");
  }

  locked_meta.visibility = new_vis.clone();
  match save_meta_atomic(&git_dir, &locked_meta) {
    Ok(_) => {
      let _ = remove_file_if_exists(&lock_path);
      return Ok(locked_meta);
    }
    Err(_) => {
      let _ = remove_file_if_exists(&lock_path);
      return Err("storage_failure");
    }
  }
}

pub fn update_default_branch_managed(root: &String, id: &String, new_branch: &String, caller: &String) -> Result<RepoMeta, String>
  intent "owner のみが既定ブランチを変更できる。読取権限のない主体には 404（not_found）を返し存在を隠蔽する。排他ロック下で再検査・atomic 更新する"
  requires none
  ensures none
  effects fs, random
{
  if !repo_id_ok(&id) {
    return Err("not_found");
  }
  if new_branch.byte_len() == 0 || !ref_name_safe(&new_branch) || validate_ref_name(&cat3(&"refs/heads/", &new_branch, &"")).is_err() {
    return Err("invalid_default_branch");
  }
  let r_id3 = cat3(&root, &"/", &id);
  let git_dir = cat3(&r_id3, &".git", &"");
  let mut cur_meta = empty_meta();
  match load_meta(&git_dir, &id) {
    Ok(m) => {
      cur_meta = m;
    }
    Err(_) => {
      return Err("not_found");
    }
  }
  if !can_read(&cur_meta, &Some(caller.clone())) {
    return Err("not_found");
  }
  if !can_manage(&cur_meta, &Some(caller.clone())) {
    return Err("forbidden");
  }

  let lock_path = meta_lock_path(&git_dir);
  match lock_create(&lock_path) {
    Ok(f) => {
      let _ = f.close();
    }
    Err(_) => {
      return Err("conflict");
    }
  }

  let mut locked_meta = empty_meta();
  match load_meta(&git_dir, &id) {
    Ok(m) => {
      locked_meta = m;
    }
    Err(_) => {
      let _ = remove_file_if_exists(&lock_path);
      return Err("not_found");
    }
  }
  if !can_read(&locked_meta, &Some(caller.clone())) {
    let _ = remove_file_if_exists(&lock_path);
    return Err("not_found");
  }
  if !can_manage(&locked_meta, &Some(caller.clone())) {
    let _ = remove_file_if_exists(&lock_path);
    return Err("forbidden");
  }

  let head_path = join_path(&git_dir, &"HEAD");
  let head_tmp = match random_hex(8) {
    Ok(h) => cat3(&head_path, &".tmp-", &h),
    Err(_) => cat3(&head_path, &".tmp-", &"1"),
  };
  let head_content = cat3(&"ref: refs/heads/", &new_branch, &"\n");
  match create_synced_file(&head_tmp, &head_content.as_bytes()) {
    Ok(_) => {
      match rename_file(&head_tmp, &head_path) {
        Ok(_) => {
          let _ = sync_dir(&git_dir);
          let prev_branch = locked_meta.default_branch.clone();
          locked_meta.default_branch = new_branch.clone();
          match save_meta_atomic(&git_dir, &locked_meta) {
            Ok(_) => {
              let _ = remove_file_if_exists(&lock_path);
              return Ok(locked_meta);
            }
            Err(_) => {
              let prev_head_content = cat3(&"ref: refs/heads/", &prev_branch, &"\n");
              let rb_tmp = match random_hex(8) {
                Ok(h) => cat3(&head_path, &".tmp-rb-", &h),
                Err(_) => cat3(&head_path, &".tmp-rb-", &"1"),
              };
              if create_synced_file(&rb_tmp, &prev_head_content.as_bytes()).is_ok() {
                let _ = rename_file(&rb_tmp, &head_path);
                let _ = sync_dir(&git_dir);
              } else {
                let _ = remove_file_if_exists(&rb_tmp);
              }
              let _ = remove_file_if_exists(&lock_path);
              return Err("storage_failure");
            }
          }
        }
        Err(_) => {
          let _ = remove_file_if_exists(&head_tmp);
          let _ = remove_file_if_exists(&lock_path);
          return Err("storage_failure");
        }
      }
    }
    Err(_) => {
      let _ = remove_file_if_exists(&head_tmp);
      let _ = remove_file_if_exists(&lock_path);
      return Err("storage_failure");
    }
  }
}

pub fn update_acl_managed(root: &String, id: &String, new_owners: &List<String>, new_writers: &List<String>, new_readers: &List<String>, caller: &String) -> Result<RepoMeta, String>
  intent "owner のみが ACL を変更できる。読取権限のない主体には 404（not_found）を返し存在を隠蔽する。排他ロック下で再検査・atomic 更新する"
  requires none
  ensures none
  effects fs, random
{
  if !repo_id_ok(&id) {
    return Err("not_found");
  }
  if new_owners.len() < 1 {
    return Err("owner_required");
  }
  if !check_subject_list(&new_owners) || !check_subject_list(&new_writers) || !check_subject_list(&new_readers) {
    return Err("invalid_subject");
  }

  let r_id4 = cat3(&root, &"/", &id);
  let git_dir = cat3(&r_id4, &".git", &"");
  let mut cur_meta = empty_meta();
  match load_meta(&git_dir, &id) {
    Ok(m) => {
      cur_meta = m;
    }
    Err(_) => {
      return Err("not_found");
    }
  }
  if !can_read(&cur_meta, &Some(caller.clone())) {
    return Err("not_found");
  }
  if !can_manage(&cur_meta, &Some(caller.clone())) {
    return Err("forbidden");
  }

  let lock_path = meta_lock_path(&git_dir);
  match lock_create(&lock_path) {
    Ok(f) => {
      let _ = f.close();
    }
    Err(_) => {
      return Err("conflict");
    }
  }

  let mut locked_meta = empty_meta();
  match load_meta(&git_dir, &id) {
    Ok(m) => {
      locked_meta = m;
    }
    Err(_) => {
      let _ = remove_file_if_exists(&lock_path);
      return Err("not_found");
    }
  }
  if !can_read(&locked_meta, &Some(caller.clone())) {
    let _ = remove_file_if_exists(&lock_path);
    return Err("not_found");
  }
  if !can_manage(&locked_meta, &Some(caller.clone())) {
    let _ = remove_file_if_exists(&lock_path);
    return Err("forbidden");
  }

  locked_meta.owners = new_owners.clone();
  locked_meta.writers = new_writers.clone();
  locked_meta.readers = new_readers.clone();
  match save_meta_atomic(&git_dir, &locked_meta) {
    Ok(_) => {
      let _ = remove_file_if_exists(&lock_path);
      return Ok(locked_meta);
    }
    Err(_) => {
      let _ = remove_file_if_exists(&lock_path);
      return Err("storage_failure");
    }
  }
}

fn dir_file_bytes_rec(dir: &String) -> Result<Int, GitError>
  intent "ディレクトリ内のすべての通常ファイルのサイズを再帰的に合計する"
  requires none
  ensures none
  effects fs
{
  if !dir_exists(&dir)? {
    return Ok(0);
  }
  let mut total = 0;
  let names = list_names(&dir, 1000)?;
  let mut i = 0;
  while i < names.len() {
    match names.get(i) {
      Some(name) => {
        let p = join_path(&dir, &name);
        if dir_exists(&p)? {
          total = total + dir_file_bytes_rec(&p)?;
        } else {
          match open_read(&p) {
            Ok(f) => {
              total = total + file_size(&f)?;
              let _ = f.close();
            }
            Err(_) => {}
          }
        }
      }
      None => {}
    }
    i = i + 1;
  }
  return Ok(total);
}

pub fn is_usage_exceeded(usage: &RepoUsage) -> Bool
  intent "使用量がオブジェクト数またはストレージバイト数の上限を超過しているかを判定する"
  requires none
  ensures none
  effects none
{
  if usage.object_count > usage.max_objects {
    return true;
  }
  if usage.usage_bytes > usage.max_storage_bytes {
    return true;
  }
  return false;
}

pub fn check_repo_storage_limits(usage: &RepoUsage) -> Result<Bool, GitError>
  intent "リポジトリ使用量が上限以内かを検査し、超過していれば LimitExceeded エラーを返す"
  requires none
  ensures none
  effects none
{
  if usage.object_count > usage.max_objects {
    return Err(GitError.LimitExceeded("object count exceeds repository limit"));
  }
  if usage.usage_bytes > usage.max_storage_bytes {
    return Err(GitError.LimitExceeded("storage bytes exceed repository limit"));
  }
  return Ok(true);
}

pub fn calc_repo_storage(git_dir: &String) -> Result<RepoUsage, GitError>
  intent "リポジトリの使用量（オブジェクト件数、合計バイト数）を数える。入れ子 ref や pack 内オブジェクトも集計する"
  requires none
  ensures none
  effects fs
{
  let mut obj_count = 0;
  let mut total_bytes = 0;

  let meta_path = meta_file_path(&git_dir);
  match open_read(&meta_path) {
    Ok(f) => {
      total_bytes = total_bytes + file_size(&f)?;
      let _ = f.close();
    }
    Err(_) => {}
  }
  let head_path = join_path(&git_dir, &"HEAD");
  match open_read(&head_path) {
    Ok(f) => {
      total_bytes = total_bytes + file_size(&f)?;
      let _ = f.close();
    }
    Err(_) => {}
  }
  let config_path = join_path(&git_dir, &"config");
  match open_read(&config_path) {
    Ok(f) => {
      total_bytes = total_bytes + file_size(&f)?;
      let _ = f.close();
    }
    Err(_) => {}
  }
  let packed_path = join_path(&git_dir, &"packed-refs");
  match open_read(&packed_path) {
    Ok(f) => {
      total_bytes = total_bytes + file_size(&f)?;
      let _ = f.close();
    }
    Err(_) => {}
  }

  let obj_dir = join_path(&git_dir, &"objects");
  if dir_exists(&obj_dir)? {
    let top_names = list_names(&obj_dir, 300)?;
    let mut i = 0;
    while i < top_names.len() {
      match top_names.get(i) {
        Some(name) => {
          if name == "pack" {
            let pack_dir = join_path(&obj_dir, &"pack");
            if dir_exists(&pack_dir)? {
              let pfiles = list_names(&pack_dir, 1000)?;
              let mut pi = 0;
              while pi < pfiles.len() {
                match pfiles.get(pi) {
                  Some(pf) => {
                    let pf_path = join_path(&pack_dir, &pf);
                    if string_ends_with(&pf, &".idx") {
                      match open_pack(&pf_path) {
                        Ok(ps) => {
                          obj_count = obj_count + ps.count;
                        }
                        Err(_) => {}
                      }
                    }
                    match open_read(&pf_path) {
                      Ok(f) => {
                        total_bytes = total_bytes + file_size(&f)?;
                        let _ = f.close();
                      }
                      Err(_) => {}
                    }
                  }
                  None => {}
                }
                pi = pi + 1;
              }
            }
          } else if name.byte_len() == 2 {
            let sub_dir = join_path(&obj_dir, &name);
            if dir_exists(&sub_dir)? {
              let ofiles = list_names(&sub_dir, 1000)?;
              let mut oi = 0;
              while oi < ofiles.len() {
                match ofiles.get(oi) {
                  Some(obj_file) => {
                    obj_count = obj_count + 1;
                    let obj_path = join_path(&sub_dir, &obj_file);
                    match open_read(&obj_path) {
                      Ok(f) => {
                        total_bytes = total_bytes + file_size(&f)?;
                        let _ = f.close();
                      }
                      Err(_) => {}
                    }
                  }
                  None => {}
                }
                oi = oi + 1;
              }
            }
          }
        }
        None => {}
      }
      i = i + 1;
    }
  }

  let refs_dir = join_path(&git_dir, &"refs");
  if dir_exists(&refs_dir)? {
    total_bytes = total_bytes + dir_file_bytes_rec(&refs_dir)?;
  }

  return Ok(RepoUsage { object_count: obj_count, usage_bytes: total_bytes, max_objects: 4096, max_storage_bytes: 67108864 });
}

pub fn list_accessible_repos(root: &String, caller: &Option<String>) -> List<RepoMeta>
  intent "root 内のリポジトリのうち、主体が読取可能なものだけを一覧にして返す。不明版・破損・欠落のものは除外する"
  requires none
  ensures none
  effects fs
{
  let mut out = List.new();
  let mut entries = List.new();
  match list_names(&root, 1000) {
    Ok(e) => {
      entries = e;
    }
    Err(_) => {
      return out;
    }
  }
  let mut i = 0;
  while i < entries.len() {
    match entries.get(i) {
      Some(entry) => {
        if string_ends_with(&entry, &".git") && entry.byte_len() > 4 {
          let id = entry.as_bytes().slice(0, entry.byte_len() - 4).unwrap_or(Bytes.new()).to_string_utf8().unwrap_or("");
          if repo_id_ok(&id) {
            let git_dir = join_path(&root, &entry);
            match load_meta(&git_dir, &id) {
              Ok(meta) => {
                if can_read(&meta, &caller) {
                  out.push(meta);
                }
              }
              Err(_) => {}
            }
          }
        }
      }
      None => {}
    }
    i = i + 1;
  }
  return out;
}

fn copy_file_synced(src: &String, dst: &String) -> Result<Bool, GitError>
  intent "ファイルを読み、同期書き込みで複写する"
  requires none
  ensures none
  effects fs
{
  let mut data = Bytes.new();
  match read_file_opt(&src, 67108864, false)? {
    Some(d) => {
      data = d;
    }
    None => {
      return Err(GitError.NotFound("file not found for copy"));
    }
  }
  create_synced_file(&dst, &data)?;
  return Ok(true);
}

fn copy_dir_rec(src: &String, dst: &String) -> Result<Bool, GitError>
  intent "ディレクトリを再帰的に複写し同期する"
  requires none
  ensures none
  effects fs
{
  make_dirs(&dst)?;
  let names = list_names(&src, 1000)?;
  let mut i = 0;
  while i < names.len() {
    match names.get(i) {
      Some(name) => {
        let s = join_path(&src, &name);
        let d = join_path(&dst, &name);
        if dir_exists(&s)? {
          copy_dir_rec(&s, &d)?;
        } else {
          copy_file_synced(&s, &d)?;
        }
      }
      None => {}
    }
    i = i + 1;
  }
  sync_dir(&dst)?;
  return Ok(true);
}

fn verify_file_content_equal(src: &String, dst: &String) -> Result<Bool, GitError>
  intent "2つのファイルの存在と内容が一致することを検証する"
  requires none
  ensures none
  effects fs
{
  let s_exists = file_exists(&src)?;
  let d_exists = file_exists(&dst)?;
  if !s_exists {
    if d_exists {
      return Err(GitError.Corrupt("verification failed: unexpected target file"));
    }
    return Ok(true);
  }
  if !d_exists {
    return Err(GitError.Corrupt("verification failed: missing target file"));
  }
  let mut s_data = Bytes.new();
  match read_file_opt(&src, 67108864, false)? {
    Some(d) => {
      s_data = d;
    }
    None => {
      return Err(GitError.Corrupt("verification failed: unreadable source file"));
    }
  }
  let mut d_data = Bytes.new();
  match read_file_opt(&dst, 67108864, false)? {
    Some(d) => {
      d_data = d;
    }
    None => {
      return Err(GitError.Corrupt("verification failed: unreadable target file"));
    }
  }
  if s_data != d_data {
    return Err(GitError.Corrupt("verification failed: file content mismatch"));
  }
  return Ok(true);
}

fn verify_dir_rec(src: &String, dst: &String) -> Result<Bool, GitError>
  intent "ディレクトリ内のすべてのエントリ（ファイル・サブディレクトリ）の件数と内容が一致することを再帰的に検証する"
  requires none
  ensures none
  effects fs
{
  let s_exists = dir_exists(&src)?;
  let d_exists = dir_exists(&dst)?;
  if !s_exists {
    if d_exists {
      return Err(GitError.Corrupt("verification failed: unexpected target directory"));
    }
    return Ok(true);
  }
  if !d_exists {
    return Err(GitError.Corrupt("verification failed: missing target directory"));
  }

  let s_names = list_names(&src, 1000)?;
  let d_names = list_names(&dst, 1000)?;
  if s_names.len() != d_names.len() {
    return Err(GitError.Corrupt("verification failed: entry count mismatch in directory"));
  }

  let mut i = 0;
  while i < s_names.len() {
    match s_names.get(i) {
      Some(name) => {
        let s_path = join_path(&src, &name);
        let d_path = join_path(&dst, &name);
        if dir_exists(&s_path)? {
          verify_dir_rec(&s_path, &d_path)?;
        } else {
          verify_file_content_equal(&s_path, &d_path)?;
        }
      }
      None => {}
    }
    i = i + 1;
  }
  return Ok(true);
}

fn backup_inner(repo_dir: &String, backup_dir: &String) -> Result<Bool, GitError>
  intent "排他ロック内でファイルを複写し検証する。バックアップ先が既に存在し空でない場合は拒否する"
  requires none
  ensures none
  effects fs
{
  let meta_path = meta_file_path(&repo_dir);
  if !file_exists(&meta_path)? {
    return Err(GitError.Corrupt("missing metadata for backup"));
  }
  let mut meta_data = Bytes.new();
  match read_file_opt(&meta_path, 16384, false)? {
    Some(d) => {
      meta_data = d;
    }
    None => {
      return Err(GitError.Corrupt("missing metadata for backup"));
    }
  }

  if dir_exists(&backup_dir)? {
    let names = list_names(&backup_dir, 10)?;
    if names.len() > 0 {
      return Err(GitError.AlreadyExists("backup directory is not empty"));
    }
  }

  make_dirs(&backup_dir)?;
  let mark_path = join_path(&backup_dir, &"sigil-backup.complete");

  let config_path = join_path(&repo_dir, &"config");
  if file_exists(&config_path)? {
    copy_file_synced(&config_path, &join_path(&backup_dir, &"config"))?;
  }
  let head_path = join_path(&repo_dir, &"HEAD");
  if file_exists(&head_path)? {
    copy_file_synced(&head_path, &join_path(&backup_dir, &"HEAD"))?;
  } else {
    return Err(GitError.Corrupt("missing HEAD for backup"));
  }
  let packed_path = join_path(&repo_dir, &"packed-refs");
  if file_exists(&packed_path)? {
    copy_file_synced(&packed_path, &join_path(&backup_dir, &"packed-refs"))?;
  }

  copy_file_synced(&meta_path, &join_path(&backup_dir, &"sigil-metadata"))?;

  let src_obj = join_path(&repo_dir, &"objects");
  if dir_exists(&src_obj)? {
    copy_dir_rec(&src_obj, &join_path(&backup_dir, &"objects"))?;
  }

  let src_refs = join_path(&repo_dir, &"refs");
  if dir_exists(&src_refs)? {
    copy_dir_rec(&src_refs, &join_path(&backup_dir, &"refs"))?;
  }

  // 複写後の検証: metadata, HEAD, config, packed-refs, objects, refs を網羅照合
  verify_file_content_equal(&meta_path, &join_path(&backup_dir, &"sigil-metadata"))?;
  verify_file_content_equal(&head_path, &join_path(&backup_dir, &"HEAD"))?;
  verify_file_content_equal(&config_path, &join_path(&backup_dir, &"config"))?;
  verify_file_content_equal(&packed_path, &join_path(&backup_dir, &"packed-refs"))?;
  verify_dir_rec(&src_obj, &join_path(&backup_dir, &"objects"))?;
  verify_dir_rec(&src_refs, &join_path(&backup_dir, &"refs"))?;

  create_synced_file(&mark_path, &"complete\n".as_bytes())?;
  sync_dir(&backup_dir)?;
  return Ok(true);
}

pub fn backup_repo(repo_dir: &String, backup_dir: &String) -> Result<Bool, GitError>
  intent "排他ロックの下で、objects・refs・metadata を同じ確定点で複写・検証し、完了印を置く。失敗時もロックを確実に解放する"
  requires none
  ensures none
  effects fs
{
  let lock_path = meta_lock_path(&repo_dir);
  match lock_create(&lock_path) {
    Ok(f) => {
      let _ = f.close();
    }
    Err(e) => {
      return Err(e);
    }
  }

  let res = backup_inner(&repo_dir, &backup_dir);
  let _ = remove_file_if_exists(&lock_path);
  return res;
}

pub fn restore_repo(backup_dir: &String, target_dir: &String) -> Result<Bool, GitError>
  intent "完了印と ACL（metadata）を備えたバックアップから、空の宛先ディレクトリへ復元する。metadata は全データ復元後にアトミックに配置する"
  requires none
  ensures none
  effects fs, random
{
  let mark_path = join_path(&backup_dir, &"sigil-backup.complete");
  if !file_exists(&mark_path)? {
    return Err(GitError.Corrupt("incomplete backup: missing completion mark"));
  }
  let meta_path = join_path(&backup_dir, &"sigil-metadata");
  if !file_exists(&meta_path)? {
    return Err(GitError.Corrupt("missing metadata in backup"));
  }
  let mut meta_bytes = Bytes.new();
  match read_file_opt(&meta_path, 16384, false)? {
    Some(b) => {
      meta_bytes = b;
    }
    None => {
      return Err(GitError.Corrupt("cannot read metadata in backup"));
    }
  }
  let mut verified_meta = empty_meta();
  match parse_meta(&meta_bytes, &"") {
    Ok(m) => {
      verified_meta = m;
    }
    Err(_) => {
      return Err(GitError.Corrupt("corrupt or invalid metadata in backup"));
    }
  }

  if dir_exists(&target_dir)? {
    let names = list_names(&target_dir, 10)?;
    if names.len() > 0 {
      return Err(GitError.AlreadyExists("target directory is not empty"));
    }
  }

  make_dirs(&target_dir)?;

  let config_path = join_path(&backup_dir, &"config");
  if file_exists(&config_path)? {
    copy_file_synced(&config_path, &join_path(&target_dir, &"config"))?;
  }
  let head_path = join_path(&backup_dir, &"HEAD");
  if file_exists(&head_path)? {
    copy_file_synced(&head_path, &join_path(&target_dir, &"HEAD"))?;
  }
  let packed_path = join_path(&backup_dir, &"packed-refs");
  if file_exists(&packed_path)? {
    copy_file_synced(&packed_path, &join_path(&target_dir, &"packed-refs"))?;
  }

  let src_obj = join_path(&backup_dir, &"objects");
  if dir_exists(&src_obj)? {
    copy_dir_rec(&src_obj, &join_path(&target_dir, &"objects"))?;
  }

  let src_refs = join_path(&backup_dir, &"refs");
  if dir_exists(&src_refs)? {
    copy_dir_rec(&src_refs, &join_path(&target_dir, &"refs"))?;
  }

  sync_dir(&target_dir)?;

  match save_meta_atomic(&target_dir, &verified_meta) {
    Ok(_) => {}
    Err(e) => {
      return Err(e);
    }
  }

  return match open_repo(&target_dir) {
    Ok(_) => Ok(true),
    Err(e) => Err(e),
  };
}

pub fn escape_json_string(s: &String) -> String
  intent "JSON 文字列として安全にエスケープする（ダブルクオート、バックスラッシュ、制御文字）"
  requires none
  ensures none
  effects none
{
  let b = s.as_bytes();
  let mut out = Bytes.new();
  let mut i = 0;
  while i < b.byte_len() {
    let c = b.get(i).unwrap_or(0);
    if c == 34 {
      out.push(92);
      out.push(34);
    } else if c == 92 {
      out.push(92);
      out.push(92);
    } else if c == 8 {
      out.push(92);
      out.push(98);
    } else if c == 12 {
      out.push(92);
      out.push(102);
    } else if c == 10 {
      out.push(92);
      out.push(110);
    } else if c == 13 {
      out.push(92);
      out.push(114);
    } else if c == 9 {
      out.push(92);
      out.push(116);
    } else if c < 32 {
      out.push(92);
      out.push(117);
      out.push(48);
      out.push(48);
      let hi = c / 16;
      let lo = c % 16;
      if hi < 10 {
        out.push(48 + hi);
      } else {
        out.push(87 + hi);
      }
      if lo < 10 {
        out.push(48 + lo);
      } else {
        out.push(87 + lo);
      }
    } else {
      out.push(c);
    }
    i = i + 1;
  }
  return out.to_string_utf8().unwrap_or("");
}

pub fn json_quote(s: &String) -> String
  intent "エスケープした上でダブルクオートで囲む"
  requires none
  ensures none
  effects none
{
  let escaped = escape_json_string(&s);
  return cat3(&"\"", &escaped, &"\"");
}

pub fn list_to_json_array(l: &List<String>) -> String
  intent "文字列リストを JSON 配列文字列にする（各要素をエスケープ）"
  requires none
  ensures none
  effects none
{
  let mut out = "";
  let mut i = 0;
  while i < l.len() {
    match l.get(i) {
      Some(s) => {
        if i > 0 {
          out = cat2(&out, &",");
        }
        out = cat2(&out, &json_quote(&s));
      }
      None => {}
    }
    i = i + 1;
  }
  return out;
}

pub fn meta_to_json(meta: &RepoMeta) -> String
  intent "RepoMeta を JSON 文字列にする（各フィールドをエスケープ）"
  requires none
  ensures none
  effects none
{
  let mut out = "{\"id\":";
  out = cat2(&out, &json_quote(&meta.id));
  out = cat2(&out, &",\"version\":");
  out = cat2(&out, &int_to_str(meta.version));
  out = cat2(&out, &",\"visibility\":");
  out = cat2(&out, &json_quote(&meta.visibility));
  out = cat2(&out, &",\"default_branch\":");
  out = cat2(&out, &json_quote(&meta.default_branch));
  out = cat2(&out, &",\"owners\":[");
  out = cat2(&out, &list_to_json_array(&meta.owners));
  out = cat2(&out, &"],\"writers\":[");
  out = cat2(&out, &list_to_json_array(&meta.writers));
  out = cat2(&out, &"],\"readers\":[");
  out = cat2(&out, &list_to_json_array(&meta.readers));
  out = cat2(&out, &"]}");
  return out;
}

pub fn repo_detail_to_json(meta: &RepoMeta, usage: &RepoUsage) -> String
  intent "RepoMeta と RepoUsage を JSON 文字列にする（各フィールドをエスケープ）"
  requires none
  ensures none
  effects none
{
  let mut out = "{\"id\":";
  out = cat2(&out, &json_quote(&meta.id));
  out = cat2(&out, &",\"version\":");
  out = cat2(&out, &int_to_str(meta.version));
  out = cat2(&out, &",\"visibility\":");
  out = cat2(&out, &json_quote(&meta.visibility));
  out = cat2(&out, &",\"default_branch\":");
  out = cat2(&out, &json_quote(&meta.default_branch));
  out = cat2(&out, &",\"owners\":[");
  out = cat2(&out, &list_to_json_array(&meta.owners));
  out = cat2(&out, &"],\"writers\":[");
  out = cat2(&out, &list_to_json_array(&meta.writers));
  out = cat2(&out, &"],\"readers\":[");
  out = cat2(&out, &list_to_json_array(&meta.readers));
  out = cat2(&out, &"],\"usage_bytes\":");
  out = cat2(&out, &int_to_str(usage.usage_bytes));
  out = cat2(&out, &",\"max_storage_bytes\":");
  out = cat2(&out, &int_to_str(usage.max_storage_bytes));
  out = cat2(&out, &",\"object_count\":");
  out = cat2(&out, &int_to_str(usage.object_count));
  out = cat2(&out, &",\"max_objects\":");
  out = cat2(&out, &int_to_str(usage.max_objects));
  out = cat2(&out, &"}");
  return out;
}

pub fn repos_list_to_json(list: &List<RepoMeta>) -> String
  intent "RepoMeta リストを JSON 配列文字列にする"
  requires none
  ensures none
  effects none
{
  let mut out = "[";
  let mut i = 0;
  while i < list.len() {
    match list.get(i) {
      Some(m) => {
        if i > 0 {
          out = cat2(&out, &",");
        }
        out = cat2(&out, &meta_to_json(&m));
      }
      None => {}
    }
    i = i + 1;
  }
  out = cat2(&out, &"]");
  return out;
}

pub fn json_str(value: &JsonValue, name: &String) -> Option<String>
  intent "JSON からキー name の文字列を読む"
  requires none
  ensures none
  effects none
{
  let nodes = value.nodes();
  let node = nodes.get(value.root())?;
  match node {
    JsonNode.Object(fields) => {
      let mut i = 0;
      while i < fields.len() {
        let field = fields.get(i)?;
        if field.name() == name {
          let child = nodes.get(field.index())?;
          return match child {
            JsonNode.Str(s) => Some(s.clone()),
            _ => None,
          };
        }
        i = i + 1;
      }
    }
    _ => {}
  }
  return None;
}

pub fn json_string_list(value: &JsonValue, name: &String) -> Option<List<String>>
  intent "JSON からキー name の文字列配列を読む"
  requires none
  ensures none
  effects none
{
  let nodes = value.nodes();
  let node = nodes.get(value.root())?;
  match node {
    JsonNode.Object(fields) => {
      let mut i = 0;
      while i < fields.len() {
        let field = fields.get(i)?;
        if field.name() == name {
          let child = nodes.get(field.index())?;
          match child {
            JsonNode.Array(items) => {
              let mut list = List.new();
              let mut j = 0;
              while j < items.len() {
                let idx = items.get(j)?;
                let item_node = nodes.get(idx)?;
                match item_node {
                  JsonNode.Str(s) => {
                    list.push(s.clone());
                  }
                  _ => {
                    return None;
                  }
                }
                j = j + 1;
              }
              return Some(list);
            }
            _ => {
              return None;
            }
          }
        }
        i = i + 1;
      }
    }
    _ => {}
  }
  return None;
}
