module git.acl
  targets server
  trust none

use git.walk.index_of;

// ADR 0048 決定 3 のうち、第 2 段が必要とする最小の認可フック。リポジトリ ACL の本格実装（metadata・可視性・owner・管理 UI）は第 4 段。
// ここにあるのは、接続試験のための固定の表（`repo:subject,subject=rw;repo:subject`。`=rw` の付いた主体は読み書き、付かない主体は読み取りだけ）だけで、永続化・変更・public-read・管理者の例外を持たない。
// 認証（0037 の Bearer）を通った主体 `sub` だけを渡す。表に無い主体・リポジトリは読めない（既定は拒否）。
// 読めない主体にはリポジトリの存在を明かさない（呼び出し側が 404 にする）。

pub struct FixedAcl {
  repos: List<String>,
  readers: List<List<String>>,
  writers: List<List<String>>,
}

pub fn repo_id_ok(id: &String) -> Bool
  intent "リポジトリ id が正規形 [a-z0-9_-]{1,64} か"
  requires none
  ensures none
  effects none
{
  let b = id.as_bytes();
  if b.len() < 1 || b.len() > 64 {
    return false;
  }
  let mut i = 0;
  while i < b.len() {
    let c = b.get(i).unwrap_or(0);
    let ok = (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 || c == 45;
    if !ok {
      return false;
    }
    i = i + 1;
  }
  return true;
}

fn split_on(s: &String, sep: Int) -> List<String>
  intent "1 byte の区切りで分割する（空の項目は捨てる）"
  requires none
  ensures none
  effects none
{
  let b = s.as_bytes();
  let mut out = List.new();
  let mut cur = Bytes.new();
  let mut i = 0;
  while i < b.len() {
    let c = b.get(i).unwrap_or(0);
    if c == sep {
      if cur.len() > 0 {
        out.push(cur.to_string_utf8().unwrap_or(""));
      }
      cur = Bytes.new();
    } else {
      cur.push(c);
    }
    i = i + 1;
  }
  if cur.len() > 0 {
    out.push(cur.to_string_utf8().unwrap_or(""));
  }
  return out;
}

fn str_at(l: &List<String>, i: Int) -> String
  intent "文字列のリストの i 番目の複製を返す（範囲外は空）"
  requires none
  ensures none
  effects none
{
  return match l.get(i) {
    Some(v) => v.clone(),
    None => "",
  };
}

pub fn subject_name_ok(name: &String) -> Bool
  intent "主体名が非空かつ安全な文字 [a-zA-Z0-9_-]{1,64} か"
  requires none
  ensures none
  effects none
{
  let b = name.as_bytes();
  if b.len() < 1 || b.len() > 64 {
    return false;
  }
  let mut i = 0;
  while i < b.len() {
    let c = b.get(i).unwrap_or(0);
    let ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95 || c == 45;
    if !ok {
      return false;
    }
    i = i + 1;
  }
  return true;
}

pub fn parse_fixed_acl(text: &String) -> Result<FixedAcl, String>
  intent "`repo:subject,subject;repo:subject` を読む。リポジトリ id が正規形でない・重複・主体が空のときは Err（固定の理由だけ）"
  requires none
  ensures none
  effects none
{
  let mut repos = List.new();
  let mut readers = List.new();
  let mut writers = List.new();
  let entries = split_on(&text, 59);
  let mut i = 0;
  while i < entries.len() {
    let e = str_at(&entries, i);
    let eb = e.as_bytes();
    let mut colon_count = 0;
    let mut c_idx = 0;
    while c_idx < eb.len() {
      if eb.get(c_idx).unwrap_or(0) == 58 {
        colon_count = colon_count + 1;
      }
      c_idx = c_idx + 1;
    }
    if colon_count != 1 {
      return Err("invalid_acl");
    }
    let parts = split_on(&e, 58);
    if parts.len() != 2 {
      return Err("invalid_acl");
    }
    let id = str_at(&parts, 0);
    if !repo_id_ok(&id) || index_of(&repos, &id) >= 0 {
      return Err("invalid_acl");
    }
    let sub_text = str_at(&parts, 1);
    let sb = sub_text.as_bytes();
    if sb.len() == 0 || sb.get(0).unwrap_or(0) == 44 || sb.get(sb.len() - 1).unwrap_or(0) == 44 {
      return Err("invalid_acl");
    }
    let mut prev_comma = false;
    let mut j = 0;
    while j < sb.len() {
      let sc = sb.get(j).unwrap_or(0);
      if sc == 44 {
        if prev_comma {
          return Err("invalid_acl");
        }
        prev_comma = true;
      } else {
        prev_comma = false;
      }
      j = j + 1;
    }
    let subs = split_on(&sub_text, 44);
    if subs.len() == 0 {
      return Err("invalid_acl");
    }
    let mut names = List.new();
    let mut writer_names = List.new();
    let mut k = 0;
    while k < subs.len() {
      let item = str_at(&subs, k);
      let ib = item.as_bytes();
      if ib.len() == 0 || ib.get(0).unwrap_or(0) == 61 || ib.get(ib.len() - 1).unwrap_or(0) == 61 {
        return Err("invalid_acl");
      }
      let mut eq_count = 0;
      let mut eq_idx = 0;
      while eq_idx < ib.len() {
        if ib.get(eq_idx).unwrap_or(0) == 61 {
          eq_count = eq_count + 1;
        }
        eq_idx = eq_idx + 1;
      }
      if eq_count > 1 {
        return Err("invalid_acl");
      }
      let kv = split_on(&item, 61);
      if kv.len() < 1 || kv.len() > 2 {
        return Err("invalid_acl");
      }
      let name = str_at(&kv, 0);
      if !subject_name_ok(&name) {
        return Err("invalid_acl");
      }
      if kv.len() == 2 {
        if str_at(&kv, 1) != "rw" {
          return Err("invalid_acl");
        }
        writer_names.push(name.clone());
      }
      names.push(name);
      k = k + 1;
    }
    repos.push(id);
    readers.push(names);
    writers.push(writer_names);
    i = i + 1;
  }
  return Ok(FixedAcl { repos: repos, readers: readers, writers: writers });
}

pub fn can_read(acl: &FixedAcl, subject: &String, repo: &String) -> Bool
  intent "認証済みの主体 subject が repo を読めるか（表にあるときだけ true）"
  requires none
  ensures none
  effects none
{
  let at = index_of(&acl.repos, &repo);
  if at < 0 {
    return false;
  }
  return match acl.readers.get(at) {
    Some(subs) => index_of(&subs, &subject) >= 0,
    None => false,
  };
}

pub fn can_write(acl: &FixedAcl, subject: &String, repo: &String) -> Bool
  intent "認証済みの主体 subject が repo へ書けるか（表で `=rw` の付いた主体だけ true。書けても読めない主体はいない）"
  requires none
  ensures none
  effects none
{
  let at = index_of(&acl.repos, &repo);
  if at < 0 {
    return false;
  }
  return match acl.writers.get(at) {
    Some(subs) => index_of(&subs, &subject) >= 0,
    None => false,
  };
}
