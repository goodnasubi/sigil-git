pub fn is_unsupported_entry(err: &GitError) -> Bool
  intent "UnsupportedEntry エラー（symlink・gitlink など作業木に作らないエントリ）かどうか判定する"
  requires none
  ensures none
  effects none
{
  return match err {
    GitError.UnsupportedEntry(_) => true,
