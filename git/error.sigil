module git.error
  targets server
  trust none

// ADR 0047 決定 1・4・5: リポジトリの核の構造化エラー

pub enum GitError {
  LimitExceeded(String),
  Corrupt(String),
  UnsupportedFormat(String),
  InvalidPath(String),
  InvalidRefName(String),
  TypeMismatch(String),
  Locked(String),
  Io(String),
  NotFound(String),
  AlreadyExists(String),
  RefMismatch(String),
  UnsupportedEntry(String),
  Conflict(String),
  MultipleMergeBases(String),
}

pub fn error_kind_name(err: &GitError) -> String
  intent "エラー種別の名前を返す"
  requires none
  ensures none
  effects none
{
  return match err {
    GitError.LimitExceeded(_) => "LimitExceeded",
    GitError.Corrupt(_) => "Corrupt",
    GitError.UnsupportedFormat(_) => "UnsupportedFormat",
    GitError.InvalidPath(_) => "InvalidPath",
    GitError.InvalidRefName(_) => "InvalidRefName",
    GitError.TypeMismatch(_) => "TypeMismatch",
    GitError.Locked(_) => "Locked",
    GitError.Io(_) => "Io",
    GitError.NotFound(_) => "NotFound",
    GitError.AlreadyExists(_) => "AlreadyExists",
    GitError.RefMismatch(_) => "RefMismatch",
    GitError.UnsupportedEntry(_) => "UnsupportedEntry",
    GitError.Conflict(_) => "Conflict",
    GitError.MultipleMergeBases(_) => "MultipleMergeBases",
  };
}

pub fn error_message(err: &GitError) -> String
  intent "エラーメッセージを返す"
  requires none
  ensures none
  effects none
{
  return match err {
    GitError.LimitExceeded(msg) => msg.clone(),
    GitError.Corrupt(msg) => msg.clone(),
    GitError.UnsupportedFormat(msg) => msg.clone(),
    GitError.InvalidPath(msg) => msg.clone(),
    GitError.InvalidRefName(msg) => msg.clone(),
    GitError.TypeMismatch(msg) => msg.clone(),
    GitError.Locked(msg) => msg.clone(),
    GitError.Io(msg) => msg.clone(),
    GitError.NotFound(msg) => msg.clone(),
    GitError.AlreadyExists(msg) => msg.clone(),
    GitError.RefMismatch(msg) => msg.clone(),
    GitError.UnsupportedEntry(msg) => msg.clone(),
    GitError.Conflict(msg) => msg.clone(),
    GitError.MultipleMergeBases(msg) => msg.clone(),
  };
}

pub fn is_limit_exceeded(err: &GitError) -> Bool
  intent "LimitExceeded エラーかどうか判定する"
  requires none
  ensures none
  effects none
{
  return match err {
    GitError.LimitExceeded(_) => true,
    _ => false,
  };
}

pub fn is_corrupt(err: &GitError) -> Bool
  intent "Corrupt エラーかどうか判定する"
  requires none
  ensures none
  effects none
{
  return match err {
    GitError.Corrupt(_) => true,
    _ => false,
  };
}

