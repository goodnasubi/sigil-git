  };
}

pub fn is_conflict(err: &GitError) -> Bool
  intent "Conflict エラー（チェックアウトが未保存の変更を失うため拒否された）かどうか判定する"
  requires none
  ensures none
  effects none
{
  return match err {
    GitError.Conflict(_) => true,
    _ => false,
  };
}
