module git.limits
  targets server
  trust none

// ADR 0047 決定 5: 初版の上限

pub fn max_object_size() -> Int
  intent "1 オブジェクトの展開後の最大サイズ (64 MiB = 67108864 byte) を返す"
  requires none
  ensures result == 67108864
  effects none
{
  return 67108864;
}

pub fn max_tree_entries() -> Int
  intent "tree のエントリ数の上限 (100,000) を返す"
  requires none
  ensures result == 100000
  effects none
{
  return 100000;
}

pub fn max_tree_size() -> Int
  intent "1 つの tree の符号化サイズの最大値 (16 MiB = 16777216 byte) を返す"
  requires none
  ensures result == 16777216
  effects none
{
  return 16777216;
}

pub fn max_path_total_len() -> Int
  intent "パス全長の最大値 (4096 byte) を返す"
  requires none
  ensures result == 4096
  effects none
{
  return 4096;
}

pub fn max_path_component_len() -> Int
  intent "パス構成要素の長さの最大値 (255 byte) を返す"
  requires none
  ensures result == 255
  effects none
{
  return 255;
}

pub fn max_path_depth() -> Int
  intent "パス階層の深さの最大値 (128) を返す"
  requires none
  ensures result == 128
  effects none
{
  return 128;
}

pub fn max_commit_parents() -> Int
  intent "commit の親の数の最大値 (16) を返す"
  requires none
  ensures result == 16
  effects none
{
  return 16;
}

pub fn max_commit_headers() -> Int
  intent "commit ヘッダの数の最大値 (1024) を返す"
  requires none
  ensures result == 1024
  effects none
{
  return 1024;
}

pub fn max_commit_header_total_size() -> Int
  intent "commit ヘッダの合計サイズの最大値 (64 KiB = 65536 byte) を返す"
  requires none
  ensures result == 65536
  effects none
{
  return 65536;
}

pub fn max_commit_message_size() -> Int
  intent "commit メッセージの大きさの最大値 (1 MiB = 1048576 byte) を返す"
  requires none
  ensures result == 1048576
  effects none
{
  return 1048576;
}

pub fn max_ref_name_len() -> Int
  intent "参照名の長さの最大値 (1024 byte) を返す"
  requires none
  ensures result == 1024
  effects none
{
  return 1024;
}

pub fn max_tag_message_size() -> Int
  intent "tag メッセージの大きさの最大値 (1 MiB = 1048576 byte) を返す"
  requires none
  ensures result == 1048576
  effects none
{
  return 1048576;
}

pub fn max_refs() -> Int
  intent "参照の数の上限 (100,000) を返す"
  requires none
  ensures result == 100000
  effects none
{
  return 100000;
}

pub fn max_packed_refs_size() -> Int
  intent "packed-refs の大きさの上限 (64 MiB = 67108864 byte) を返す"
  requires none
  ensures result == 67108864
  effects none
{
  return 67108864;
}

pub fn max_work_memory() -> Int
  intent "核の作業メモリの上限 (256 MiB = 268435456 byte) を返す"
  requires none
  ensures result == 268435456
  effects none
{
  return 268435456;
}

pub fn max_pack_objects() -> Int
  intent "1 つの pack が持てるオブジェクト数の上限 (2^24 = 16777216) を返す"
  requires none
  ensures result == 16777216
  effects none
{
  return 16777216;
}

pub fn max_pack_size() -> Int
  intent "pack のファイルの大きさの上限 (4 GiB = 4294967296 byte) を返す"
  requires none
  ensures result == 4294967296
  effects none
{
  return 4294967296;
}

pub fn max_delta_depth() -> Int
  intent "差分（OFS_DELTA／REF_DELTA）の連鎖の深さの上限 (64) を返す"
  requires none
  ensures result == 64
  effects none
{
  return 64;
}

pub fn max_index_entries() -> Int
  intent "索引のエントリ数の上限 (100,000) を返す"
  requires none
  ensures result == 100000
  effects none
{
  return 100000;
}

pub fn max_add_files() -> Int
  intent "1 回の add が扱うファイル数の上限 (100,000) を返す"
  requires none
  ensures result == 100000
  effects none
{
  return 100000;
}

pub fn max_index_size() -> Int
  intent "索引ファイルの大きさの上限 (64 MiB = 67108864 byte) を返す"
  requires none
  ensures result == 67108864
  effects none
{
  return 67108864;
}
