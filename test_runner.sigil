module test_runner
  targets server
  trust none

use tests.test_commit.run_commit_tests;
use tests.test_compat.run_compat_tests;
use tests.test_fault.run_fault_tests;
use tests.test_fixture.run_fixture_tests;
use tests.test_fuzz.run_fuzz_tests;
use tests.test_inflate.run_inflate_tests;
use tests.test_limits.run_limits_tests;
use tests.test_object.run_object_tests;
use tests.test_ops.run_ops_tests;
use tests.test_pack.run_pack_tests;
use tests.test_repo.run_repo_tests;
use tests.test_tag.run_tag_tests;
use tests.test_tree.run_tree_tests;
use tests.test_validate.run_validate_tests;
use tests.test_xcheck.run_xcheck_tests;

pub fn main() -> Int
  intent "すべてのテストを実行し、全合格なら 0、不合格なら 1 以上のコードを返す"
  requires none
  ensures none
  effects console, fs, random
{
  console.log(&"Running tests: limits");
  if !run_limits_tests() {
    console.log(&"FAIL: limits tests");
    return 1;
  }

  console.log(&"Running tests: object & hash");
  if !run_object_tests() {
    console.log(&"FAIL: object tests");
    return 2;
  }

  console.log(&"Running tests: tree");
  if !run_tree_tests() {
    console.log(&"FAIL: tree tests");
    return 3;
  }

  console.log(&"Running tests: commit");
  if !run_commit_tests() {
    console.log(&"FAIL: commit tests");
    return 4;
  }

  console.log(&"Running tests: tag");
  if !run_tag_tests() {
    console.log(&"FAIL: tag tests");
    return 5;
  }

  console.log(&"Running tests: validate (path & ref name)");
  if !run_validate_tests() {
    console.log(&"FAIL: validate tests");
    return 6;
  }

  console.log(&"Running tests: Git SHA-256 fixture verification");
  if !run_fixture_tests() {
    console.log(&"FAIL: fixture tests");
    return 7;
  }

  console.log(&"Running tests: zlib, init, objects, refs (filesystem)");
  if !run_repo_tests() {
    console.log(&"FAIL: repo tests");
    return 8;
  }

  console.log(&"Running tests: inflate (zlib)");
  if !run_inflate_tests() {
    console.log(&"FAIL: inflate tests");
    return 9;
  }

  console.log(&"Running tests: pack, pack index, delta, odb integration");
  if !run_pack_tests() {
    console.log(&"FAIL: pack tests");
    return 10;
  }

  console.log(&"Running tests: index, add, commit, checkout, work tree");
  if !run_ops_tests() {
    console.log(&"FAIL: ops tests");
    return 11;
  }

  console.log(&"Running tests: backward compatibility fixtures (v1)");
  if !run_compat_tests() {
    console.log(&"FAIL: compat tests");
    return 12;
  }

  console.log(&"Running tests: fuzzing & boundary regression");
  if !run_fuzz_tests() {
    console.log(&"FAIL: fuzz tests");
    return 13;
  }

  console.log(&"Running tests: fault injection & durable model");
  if !run_fault_tests() {
    console.log(&"FAIL: fault tests");
    return 14;
  }

  console.log(&"Running tests: cross-check trace digest");
  if !run_xcheck_tests() {
    console.log(&"FAIL: xcheck tests");
    return 15;
  }

  console.log(&"ALL TESTS PASSED SUCCESSFULLY");
  return 0;
}
